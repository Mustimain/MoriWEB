@* Views/Product/Products.cshtml *@
@{
    ViewData["Title"] = "Ürünler";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="mb-0">Ürünler</h3>
            <small class="text-muted">Soldan ürün seç → sağda güncelle/sil. Seçmeden formu doldur → yeni ürün oluştur.</small>
        </div>
    </div>

    <div class="row g-3">
        <!-- SOL: Liste (arama üstte) -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <h6 class="mb-0">Ürün Listesi</h6>
                        <span class="badge rounded-pill bg-secondary-subtle text-secondary" id="listCount">0</span>
                    </div>
                </div>

                <div class="card-body pt-0">
                    <!-- Arama -->
                    <div class="input-group mb-3">
                        <input id="searchBox" type="text" class="form-control" placeholder="Ürün ara (kod, ad...)">
                    </div>

                    <!-- Liste -->
                    <div id="productList" class="list-group list-group-flush border rounded" style="max-height: 65vh; overflow:auto;">
                        @* Liste JS ile doldurulur *@
                    </div>
                </div>
                @* Alt buton yok *@
            </div>
        </div>

        <!-- SAĞ: Ürün Oluştur / Güncelle / Sil -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-2">
                                <i class="bi bi-box fs-5 text-primary"></i>
                            </div>
                            <div>
                                <h5 class="mb-0" id="formTitle">Yeni Ürün</h5>
                                <small class="text-muted" id="formSub">Bilgileri doldurun ve Kaydet’e basın.</small>
                            </div>
                        </div>
                        <span class="badge text-bg-light border" id="selectedIdBadge" style="display:none;">ID:</span>
                    </div>

                    <div class="row g-3">
                        @* Stok Kodu GİZLİ — backend otomatik üretir *@
                        <input id="Code" type="hidden" />

                        <div class="col-md-8">
                            <label class="form-label">Stok Adı</label>
                            <input id="Name" class="form-control" placeholder="Ürün adı">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tarih</label>
                            <input id="CreateDate" type="date" class="form-control">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Kategori</label>
                            <select id="CategoryId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Marka</label>
                            <select id="BrandId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Kumaş Türü</label>
                            <select id="FabricTypeId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Model</label>
                            <select id="ModelId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Renk</label>
                            <select id="ColorId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>

        <div class="col-12 d-flex gap-2 justify-content-end mt-2">
            <button type="button" class="btn btn-outline-secondary" id="btnClear">
                <i class="bi bi-plus-circle"></i> Yeni Kayıt
            </button>
            <button type="button" class="btn btn-primary" id="btnSave">
                <i class="bi bi-save2"></i> Kaydet
            </button>
            <button type="button" class="btn btn-success d-none" id="btnUpdate">
                <i class="bi bi-arrow-repeat"></i> Güncelle
            </button>
            <button type="button" class="btn btn-outline-danger d-none" id="btnDelete">
                <i class="bi bi-trash"></i> Sil
            </button>
        </div>
                    </div> <!-- /row -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ---------- Yardımcılar ----------
    function g(o, ...keys){ for(const k of keys){ if(o && o[k] != null) return o[k]; } return ""; }

    function refreshCount(){
        const count = document.querySelectorAll('#productList .product-item').length;
        document.getElementById('listCount').innerText = count;
    }

    // Tarihi input[type=date] için normalize et (YYYY-MM-DD)
    function normalizeDateForInput(v){
        if(!v) return "";
        if(typeof v === "string"){
            // "2025-09-28T12:34:56" -> "2025-09-28"
            if(v.length >= 10) return v.substring(0,10);
            return v;
        }
        if(v instanceof Date){
            const yyyy=v.getFullYear(); const mm=String(v.getMonth()+1).padStart(2,'0'); const dd=String(v.getDate()).padStart(2,'0');
            return `${yyyy}-${mm}-${dd}`;
        }
        return "";
    }

    // ---------- Alan referansları ----------
    const idBadge   = document.getElementById('selectedIdBadge');
    const formTitle = document.getElementById('formTitle');
    const formSub   = document.getElementById('formSub');
    const btnClear  = document.getElementById('btnClear');
    const btnSave   = document.getElementById('btnSave');
    const btnUpdate = document.getElementById('btnUpdate');
    const btnDelete = document.getElementById('btnDelete');

    const fields = ["Name","CreateDate","CategoryId","BrandId","FabricTypeId","ModelId","ColorId"];

    function setForm(obj){
        const map = {
            Name:['name','Name'],
            CreateDate:['createDate','CreateDate'],
            CategoryId:['categoryId','CategoryId'],
            BrandId:['brandId','BrandId'],
            FabricTypeId:['fabricTypeId','FabricTypeId'],
            ModelId:['modelId','ModelId'],
            ColorId:['colorId','ColorId']
        };
        for(const [k, keys] of Object.entries(map)){
            const el = document.getElementById(k);
            if(!el) continue;
            let val = g(obj, ...keys);
            if(k === 'CreateDate') val = normalizeDateForInput(val);
            el.value = val ?? "";
        }
    }
    function getForm(){
        const toInt = v => v === "" ? 0 : parseInt(v,10);
        return {
            Name: (document.getElementById('Name')?.value ?? "").trim(),
            CreateDate: document.getElementById('CreateDate')?.value ?? "",
            CategoryId: toInt(document.getElementById('CategoryId')?.value ?? ""),
            BrandId: toInt(document.getElementById('BrandId')?.value ?? ""),
            FabricTypeId: toInt(document.getElementById('FabricTypeId')?.value ?? ""),
            ModelId: toInt(document.getElementById('ModelId')?.value ?? ""),
            ColorId: toInt(document.getElementById('ColorId')?.value ?? "")
        };
    }
    function setSelected(id){
        const hasSel = !!id && id > 0;
        if(hasSel){
            idBadge.style.display='inline-block';
            idBadge.textContent = `ID:${id}`;
            formTitle.textContent = 'Ürün Güncelle';
            formSub.textContent   = 'Bilgileri düzenleyin ve Güncelle/Sil yapın.';
            btnClear.classList.add('d-none');
            btnSave.classList.add('d-none');
            btnUpdate.classList.remove('d-none');
            btnDelete.classList.remove('d-none');
        }else{
            idBadge.style.display='none';
            idBadge.textContent = '';
            formTitle.textContent = 'Yeni Ürün';
            formSub.textContent   = 'Bilgileri doldurun ve Kaydet’e basın.';
            btnClear.classList.remove('d-none');
            btnSave.classList.remove('d-none');
            btnUpdate.classList.add('d-none');
            btnDelete.classList.add('d-none');
        }
    }
    function getSelectedId(){
        const m = (idBadge.textContent||"").match(/ID:\s*(\d+)/i);
        return m ? parseInt(m[1]) : 0;
    }
    function clearForm(){
        setForm({});
        setSelected(0);
        document.querySelectorAll('.product-item.active').forEach(x=>x.classList.remove('active'));
        // bugün tarihi ata
        const d = new Date(); const yyyy=d.getFullYear(); const mm=String(d.getMonth()+1).padStart(2,'0'); const dd=String(d.getDate()).padStart(2,'0');
        const today = `${yyyy}-${mm}-${dd}`;
        const cd = document.getElementById('CreateDate'); if(cd) cd.value = today;
    }

    // ---------- Liste render ----------
    function renderList(items){
        const host = document.getElementById('productList');
        host.innerHTML = "";
        items.forEach(p=>{
            const id    = g(p,'id','Id');
            const name  = g(p,'name','Name') || '(Adsız)';
            const code  = g(p,'code','Code');
            const color = g(p,'colorName','ColorName');

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action d-flex align-items-start gap-3 product-item';

            const letter = (name || '?').charAt(0).toUpperCase();
            btn.innerHTML = `
                <div class="avatar rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center" style="width:38px;height:38px;">${letter}</div>
                <div class="flex-fill text-start">
                    <div class="fw-semibold">${name}</div>
                    <div class="small text-muted"><span class="me-2">Kod: ${code}</span>${color?`• <span class="ms-2">${color}</span>`:''}</div>
                </div>
                <div><span class="badge id-badge">ID:${id}</span></div>
            `;

            btn.addEventListener('click', ()=>{
                const wasActive = btn.classList.contains('active');
                document.querySelectorAll('.product-item.active').forEach(x=>x.classList.remove('active'));
                if(wasActive){
                    clearForm(); setSelected(0); return;
                }
                btn.classList.add('active');
                setForm(p);
                setSelected(id);
            });

            host.appendChild(btn);
        });
        refreshCount();
    }

    // ---------- API ----------
    async function apiList(q=""){
        const res = await fetch(`/Product/Search?q=${encodeURIComponent(q)}`);
        if(!res.ok) throw new Error('Liste alınamadı');
        return await res.json();
    }
    async function apiCreate(model){
        const res = await fetch('/Product/Create', {
            method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(model)
        });
        if(res.status===400){ alert('Zorunlu alanları kontrol edin.'); return {ok:false}; }
        if(res.status===409){ const d=await res.json().catch(()=>({})); alert(d?.message||'Aynı kodda kayıt var.'); return {ok:false}; }
        if(!res.ok){ alert('Kayıt başarısız'); return {ok:false}; }
        return {ok:true, data: await res.json()};
    }
    async function apiUpdate(id, model){
        const res = await fetch('/Product/Update', {
            method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({...model, Id:id})
        });
        if(res.status===404){ alert('Kayıt bulunamadı.'); return {ok:false}; }
        if(res.status===400){ alert('Zorunlu alanları kontrol edin.'); return {ok:false}; }
        if(res.status===409){ const d=await res.json().catch(()=>({})); alert(d?.message||'Çakışma'); return {ok:false}; }
        if(!res.ok){ alert('Güncelleme başarısız'); return {ok:false}; }
        return {ok:true, data: await res.json()};
    }
    async function apiDelete(id){
        const res = await fetch('/Product/Delete', {
            method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ Id: id })
        });
        if(res.status===404){ alert('Kayıt bulunamadı.'); return {ok:false}; }
        if(res.status===400){ alert('Geçersiz istek (id).'); return {ok:false}; }
        if(res.status===409){ const d=await res.json().catch(()=>({})); alert(d?.message||'Silinemedi (ilişkili kayıt).'); return {ok:false}; }
        if(!res.ok){ alert('Silme başarısız'); return {ok:false}; }
        return {ok:true, data: await res.json()};
    }

    // ---------- Davranışlar ----------
    (async()=>{
        // lookup’ları doldur
        await loadLookups();
        // listeyi çek
        const items = await apiList("");
        renderList(items);
        setSelected(0);
        // bugün tarih
        const d = new Date(); const yyyy=d.getFullYear(); const mm=String(d.getMonth()+1).padStart(2,'0'); const dd=String(d.getDate()).padStart(2,'0');
        document.getElementById('CreateDate').value = `${yyyy}-${mm}-${dd}`;
    })();

    document.getElementById('searchBox')?.addEventListener('input', async function(){
        const items = await apiList(this.value || "");
        renderList(items);
        setSelected(0);
    });

    btnClear?.addEventListener('click', ()=>{ clearForm(); setSelected(0); });

    btnSave?.addEventListener('click', async ()=>{
        const body = getForm();            // Code gönderilmiyor; backend üretir
        const r = await apiCreate(body);
        if(!r.ok) return;
        alert('Ürün oluşturuldu.');
        const items = await apiList(document.getElementById('searchBox')?.value || "");
        renderList(items);
        clearForm(); setSelected(0);
    });

    btnUpdate?.addEventListener('click', async ()=>{
        const id = getSelectedId(); if(!id){ alert('Seçim yok'); return; }
        const body = getForm();
        const r = await apiUpdate(id, body);
        if(!r.ok) return;
        alert('Güncellendi.');
        const items = await apiList(document.getElementById('searchBox')?.value || "");
        renderList(items);
        clearForm(); setSelected(0);
    });

    btnDelete?.addEventListener('click', async ()=>{
        const id = getSelectedId(); if(!id){ alert('Seçim yok'); return; }
        if(!confirm('Silmek istediğinize emin misiniz?')) return;
        const r = await apiDelete(id);
        if(!r.ok) return;
        // Seçili elemanı listeden hemen kaldır
        const active = document.querySelector('#productList .product-item.active');
        if(active){ active.parentElement.removeChild(active); refreshCount(); }
        clearForm(); setSelected(0);
    });

    // ---------- Lookups ----------
    async function loadLookups(){
        const res = await fetch('/Product/Lookups');
        if(!res.ok) return;
        const d = await res.json();
        fillSelect('CategoryId', d.categories);
        fillSelect('BrandId', d.brands);
        fillSelect('FabricTypeId', d.fabrics);
        fillSelect('ModelId', d.models);
        fillSelect('ColorId', d.colors);
    }
    function fillSelect(id, items){
        const sel = document.getElementById(id); if(!sel) return;
        sel.innerHTML = `<option value="">Seçiniz...</option>` + (items||[]).map(x=>`<option value="${x.id}">${x.code} - ${x.name}</option>`).join('');
    }
</script>
<style>
    /* Seçili satır: sadece arka plan açık mavi; yazılar değişmesin */
    .product-item.active{
        background-color:#e7f1ff !important;
        color:inherit !important;
        border-color:#cfe2ff !important;
    }
    .product-item.active *{ color:inherit !important; }

    /* ID rozetleri siyah yazılı kalsın */
    .id-badge{
        color:#000 !important;
        background-color:#f8f9fa !important;
        border:1px solid #dee2e6 !important;
        font-weight:500;
    }
    .avatar{ font-weight:600; }

    @@media (max-width: 991.98px){
        #productList{ max-height:40vh; }
    }
</style>
}
