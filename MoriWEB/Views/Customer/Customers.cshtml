@* Views/Customer/Customers.cshtml *@
@{
    ViewData["Title"] = "Müşteriler";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="mb-0">Müşteriler</h3>
        </div>
        <span class="badge rounded-pill bg-secondary-subtle text-secondary" id="listCount">0</span>
    </div>

    <div class="row g-3">
        <!-- SOL: Liste (arama üstte) -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <h6 class="mb-0">Müşteri Listesi</h6>
                    </div>
                </div>

                <div class="card-body pt-0">
                    <!-- Arama kutusu -->
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="searchBox" type="text" class="form-control" placeholder="Müşteri ara (ad, telefon, e-posta)">
                    </div>

                    <!-- Liste -->
                    <div id="customerList" class="list-group list-group-flush border rounded" style="max-height: 65vh; overflow:auto;">
                        @* Liste JS ile doldurulur *@
                    </div>
                </div>
            </div>
        </div>

        <!-- SAĞ: Form -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-2">
                                <i class="bi bi-person-gear fs-5 text-primary"></i>
                            </div>
                            <div>
                                <h5 class="mb-0" id="formTitle">Yeni Müşteri</h5>
                                <div id="formSub" class="text-muted small">Bilgileri doldurun ve Kaydet’e basın.</div>
                            </div>
                        </div>
                        <span class="badge text-bg-light border" id="selectedIdBadge" style="display:none;">ID:</span>
                    </div>

                    <div class="row g-3">
                        <!-- Sol kolon -->
                        <div class="col-12 col-xl-6">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">TC</label>
                                    <input id="TcNo" class="form-control" maxlength="11" placeholder="11 haneli TC kimlik no">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Ad</label>
                                    <input id="FirstName" class="form-control" placeholder="Ad">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Soyad</label>
                                    <input id="LastName" class="form-control" placeholder="Soyad">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Telefon</label>
                                    <div class="input-group">
                                        <span class="input-group-text">+90</span>
                                        <input id="PhoneNumber" class="form-control" placeholder="5xx xxx xx xx">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">E-posta</label>
                                    <input id="EmailAdress" type="email" class="form-control" placeholder="ornek@eposta.com">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Adres</label>
                                    <textarea id="Adress" class="form-control" rows="2" placeholder="Adres"></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Kargo Adresi</label>
                                    <textarea id="CargoAdress" class="form-control" rows="2" placeholder="Kargo adresi"></textarea>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" id="copyAddressChk">
                                        <label class="form-check-label" for="copyAddressChk">Adres'i Kargo Adresi olarak kopyala</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sağ kolon -->
                        <div class="col-12 col-xl-6">
                            <div class="border-start ps-3">
                                <h6 class="text-muted mb-3"><i class="bi bi-receipt-cutoff me-2"></i>Fatura Bilgileri</h6>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">Firma Adı</label>
                                        <input id="TaxCompanyName" class="form-control" placeholder="Firma adı (opsiyonel)">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Vergi Dairesi</label>
                                        <input id="TaxOffice" class="form-control" placeholder="Vergi dairesi">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Vergi No</label>
                                        <input id="TaxNo" class="form-control" placeholder="Vergi no">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Fatura Adresi</label>
                                        <textarea id="TaxAdress" class="form-control" rows="2" placeholder="Fatura adresi"></textarea>
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" id="copyCargoToTaxChk">
                                            <label class="form-check-label" for="copyCargoToTaxChk">Kargo Adresi’ni Fatura Adresi olarak kopyala</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Aksiyonlar -->
                                <div class="d-flex flex-wrap gap-2 justify-content-end mt-4">
                                    <button type="button" class="btn btn-primary" id="btnSave">
                                        <i class="bi bi-save2"></i> Kaydet
                                    </button>
                                    <button type="button" class="btn btn-success d-none" id="btnUpdate">
                                        <i class="bi bi-arrow-repeat"></i> Güncelle
                                    </button>
                                    <button type="button" class="btn btn-outline-danger d-none" id="btnDelete">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div> <!-- /row -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
/* ---------- Alan listesi ---------- */
const fields = [
  "TcNo","FirstName","LastName","PhoneNumber","EmailAdress",
  "Adress","CargoAdress","TaxCompanyName","TaxOffice","TaxNo","TaxAdress"
];

/* ---------- Elemanlar ---------- */
const searchBox = document.getElementById('searchBox');
const listHost  = document.getElementById('customerList');
const countBadge= document.getElementById('listCount');
const idBadge   = document.getElementById('selectedIdBadge');

const btnSave   = document.getElementById('btnSave');
const btnUpdate = document.getElementById('btnUpdate');
const btnDelete = document.getElementById('btnDelete');

const formTitle = document.getElementById('formTitle');
const formSub   = document.getElementById('formSub');

/* ---------- Yardımcılar ---------- */
function g(o, ...keys){ for(const k of keys){ if(o && o[k]!=null) return o[k]; } return ""; }

function setFormData(obj){
  const map={
    TcNo:['tcNo','TcNo'],
    FirstName:['firstName','FirstName'],
    LastName:['lastName','LastName'],
    PhoneNumber:['phoneNumber','PhoneNumber'],
    EmailAdress:['emailAdress','EmailAdress'],
    Adress:['adress','Adress'],
    CargoAdress:['cargoAdress','CargoAdress'],
    TaxCompanyName:['taxCompanyName','TaxCompanyName'],
    TaxOffice:['taxOffice','TaxOffice'],
    TaxNo:['taxNo','TaxNo'],
    TaxAdress:['taxAdress','TaxAdress'],
  };
  for(const [id,keys] of Object.entries(map)){
    const el=document.getElementById(id); if(!el) continue;
    el.value = g(obj,...keys) ?? '';
    el.classList.remove('is-invalid');
  }
}
function getFormData(){
  const o={};
  fields.forEach(k=>{ const el=document.getElementById(k); o[k]=(el?.value??"").trim(); });
  return o;
}
function setSelectedId(id){
  const has=!!id && id>0;
  if(has){
    idBadge.style.display='inline-block'; idBadge.textContent=`ID:${id}`;
    formTitle.textContent='Müşteri Güncelle';
    formSub.textContent='Bilgileri düzenleyin ve Güncelle/Sil yapın.';
    btnSave.classList.add('d-none'); btnUpdate.classList.remove('d-none'); btnDelete.classList.remove('d-none');
  }else{
    idBadge.style.display='none'; idBadge.textContent='';
    formTitle.textContent='Yeni Müşteri';
    formSub.textContent='Bilgileri doldurun ve Kaydet’e basın.';
    btnSave.classList.remove('d-none'); btnUpdate.classList.add('d-none'); btnDelete.classList.add('d-none');
  }
}
function getSelectedId(){ const m=(idBadge.textContent||"").match(/ID:\s*(\d+)/i); return m?parseInt(m[1],10):0; }
function clearForm(){
  setFormData({}); setSelectedId(0);
  document.querySelectorAll('.customer-item.active').forEach(x=>x.classList.remove('active'));
}

/* ---------- Liste render ---------- */
function renderList(items){
  listHost.innerHTML="";
  (items||[]).forEach(c=>{
    const btn=document.createElement('button');
    btn.type='button';
    btn.className='list-group-item list-group-item-action d-flex align-items-start gap-3 customer-item';

    const firstName=g(c,'firstName','FirstName')||'';
    const lastName =g(c,'lastName','LastName')||'';
    const phone    =g(c,'phoneNumber','PhoneNumber')||'';
    const email    =g(c,'emailAdress','EmailAdress')||'';
    const id       =g(c,'id','Id');

    const letter=(firstName||lastName||'?').charAt(0).toUpperCase();
    btn.innerHTML=`
      <div class="avatar rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center" style="width:38px;height:38px;">${letter}</div>
      <div class="flex-fill text-start">
        <div class="fw-semibold">${(firstName+" "+lastName).trim() || '(İsimsiz)'}</div>
        <div class="small text-muted">
          <i class="bi bi-telephone me-1"></i>${phone||'-'} &nbsp; • &nbsp;
          <i class="bi bi-envelope me-1"></i>${email||'-'}
        </div>
      </div>
      <span class="badge id-badge">ID:${id}</span>`;
    btn.addEventListener('click',()=>{
      const was=btn.classList.contains('active');
      document.querySelectorAll('.customer-item.active').forEach(x=>x.classList.remove('active'));
      if(was){ clearForm(); setSelectedId(0); return; }
      btn.classList.add('active'); setFormData(c); setSelectedId(id);
    });
    listHost.appendChild(btn);
  });
  countBadge.innerText = document.querySelectorAll('#customerList .customer-item').length.toString();
}

/* ---------- API (ui helperlarıyla) ---------- */
async function apiSearch(q=""){
  try{ return await ui.apiGet(`/Customer/Search?q=${encodeURIComponent(q)}`); }
  catch(_){ ui.showToast('error','Arama başarısız.'); return []; }
}
async function apiCreate(model){
  const r = await ui.apiPostJson('/Customer/Create', model);
  if(!r.ok){
    // Sunucudan özel mesaj dönebilir
    ui.showToast('error', r.message || 'Kayıt başarısız.');
    return { ok:false };
  }
  return r;
}
async function apiUpdate(model){
  const r = await ui.apiPostJson('/Customer/Update', model);
  if(!r.ok){
    ui.showToast('error', r.message || 'Güncelleme başarısız.');
    return { ok:false };
  }
  return r;
}
async function apiDelete(id){
  const r = await ui.apiPostJson('/Customer/Delete', { id });
  if(!r.ok){
    ui.showToast('error', r.message || 'Silme başarısız.');
    return { ok:false };
  }
  return r;
}

/* ---------- İlk yükleme ---------- */
(async()=>{
  const items = await apiSearch("");
  renderList(items);
  setSelectedId(0);
})();

/* ---------- Etkileşimler ---------- */
searchBox?.addEventListener('input', async function(){
  const items = await apiSearch(this.value || "");
  renderList(items);
  setSelectedId(0);
});

btnSave?.addEventListener('click', async ()=>{
  const body=getFormData();
  const r=await apiCreate(body); if(!r.ok) return;
  ui.showToast('success','Müşteri eklendi.');
  searchBox.value=""; renderList(await apiSearch("")); clearForm(); setSelectedId(0);
});

btnUpdate?.addEventListener('click', async ()=>{
  const id=getSelectedId(); if(!id){ ui.showToast('error','Güncellemek için listeden müşteri seçiniz.'); return; }
  const body=getFormData(); body.Id=id;
  const r=await apiUpdate(body); if(!r.ok) return;
  ui.showToast('success','Müşteri güncellendi.');
  renderList(await apiSearch(searchBox?.value||"")); clearForm(); setSelectedId(0);
});

btnDelete?.addEventListener('click', async ()=>{
  const id=getSelectedId(); if(!id){ ui.showToast('error','Silmek için listeden müşteri seçiniz.'); return; }
  const ok = await ui.showConfirm('Silmek istediğinize emin misiniz?', 'Silme Onayı'); if(!ok) return;
  const r=await apiDelete(id); if(!r.ok) return;
  ui.showToast('success','Silindi.');
  renderList(await apiSearch(searchBox?.value||"")); clearForm(); setSelectedId(0);
});

/* ---------- Adres kopyalama ---------- */
document.getElementById('copyAddressChk')?.addEventListener('change', function(){
  if(this.checked) document.getElementById('CargoAdress').value = document.getElementById('Adress').value || '';
});
document.getElementById('copyCargoToTaxChk')?.addEventListener('change', function(){
  if(this.checked) document.getElementById('TaxAdress').value = document.getElementById('CargoAdress').value || '';
});
</script>

<style>
.customer-item.active{
  background-color:#e7f1ff !important;
  color:inherit !important;
  border-color:#cfe2ff !important;
}
.customer-item.active *{ color:inherit !important; }

.id-badge{
  color:#000 !important;
  background-color:#f8f9fa !important;
  border:1px solid #dee2e6 !important;
  font-weight:500;
}
.avatar{ font-weight:600; }

@@media (max-width: 991.98px){
  #customerList{ max-height:40vh; }
}
</style>
}
