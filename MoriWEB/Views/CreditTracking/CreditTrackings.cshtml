@{
    ViewData["Title"] = "Veresiye Takip";
    Layout = "_Layout";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div><h3 class="mb-0">Veresiye Takip</h3></div>
        <span class="badge rounded-pill bg-secondary-subtle text-secondary" id="listCount">0</span>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="q" type="text" class="form-control" placeholder="Müşteri ara (ad / tel / e-posta)">
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-primary-subtle text-primary">Toplam Kalan: <span id="sumRemain">0,00</span></span>
                        <span class="badge bg-success-subtle text-success">Toplam Ödenen: <span id="sumPaid">0,00</span></span>
                        <span class="badge bg-secondary-subtle text-secondary">Toplam Satış: <span id="sumSales">0,00</span></span>
                    </div>

                    <div id="custList" class="list-group list-group-flush border rounded" style="max-height:65vh;overflow:auto;"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-info bg-opacity-10 p-2">
                                <i class="bi bi-person-lines-fill fs-5 text-info"></i>
                            </div>
                            <div>
                                <h5 class="mb-0" id="cName">Müşteri seçiniz</h5>
                                <div class="text-muted small" id="cMeta"></div>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-secondary-subtle text-secondary">Satış: <span id="sumSalesC">0,00</span></span>
                            <span class="badge bg-success-subtle text-success">Ödenen: <span id="sumPaidC">0,00</span></span>
                            <span class="badge bg-danger-subtle text-danger">Kalan: <span id="sumRemainC">0,00</span></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-xl-7">
                            <h6 class="mb-2">Satışlar</h6>
                            <div class="table-responsive" style="max-height:45vh;overflow:auto;">
                                <table class="table table-sm table-striped mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Tarih</th>
                                            <th>Ürün</th>
                                            <th class="text-end">Miktar</th>
                                            <th class="text-end">Net</th>
                                            <th class="text-end">Tutar</th>
                                            <th class="text-end">Ödenen</th>
                                            <th class="text-end">Kalan</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblSales"></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="col-12 col-xl-5">
                            <h6 class="mb-2">Ödeme Geçmişi</h6>
                            <div class="list-group list-group-flush border rounded" id="payList" style="max-height:45vh;overflow:auto;"></div>
                        </div>
                    </div>

                    <div id="hint" class="text-muted small mt-2">Soldan müşteri seçiniz.</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const els = {
            q: document.getElementById('q'),
            custList: document.getElementById('custList'),
            listCount: document.getElementById('listCount'),
            sumRemain: document.getElementById('sumRemain'),
            sumPaid: document.getElementById('sumPaid'),
            sumSales: document.getElementById('sumSales'),
            cName: document.getElementById('cName'),
            cMeta: document.getElementById('cMeta'),
            sumSalesC: document.getElementById('sumSalesC'),
            sumPaidC: document.getElementById('sumPaidC'),
            sumRemainC: document.getElementById('sumRemainC'),
            tblSales: document.getElementById('tblSales'),
            payList: document.getElementById('payList'),
            hint: document.getElementById('hint')
        };

        function tl(v) { return Number(v || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        function fmtDate(s) { if (!s) return '-'; const d = new Date(s); return isNaN(d) ? String(s).slice(0, 10) : d.toLocaleDateString(); }

        function renderCustomers(items) {
            els.custList.innerHTML = '';
            let totRemain = 0, totPaid = 0, totSales = 0;
            (items || []).forEach(x => {
                totRemain += Number(x.remaining || 0);
                totPaid += Number(x.totalPaid || 0);
                totSales += Number(x.totalSales || 0);

                const a = document.createElement('a');
                a.href = 'javascript:void(0)';
                a.className = 'list-group-item list-group-item-action d-flex align-items-start justify-content-between gap-2';
                a.innerHTML = `
              <div class="flex-fill">
                <div class="fw-semibold">${x.name || '(İsimsiz)'}</div>
                <div class="small text-muted">${x.phone || ''} ${x.email ? ' • ' + x.email : ''}</div>
              </div>
              <div class="text-end" style="min-width:170px">
                <div><span class="badge bg-secondary-subtle text-secondary">Satış: ${tl(x.totalSales)}</span></div>
                <div class="mt-1"><span class="badge bg-success-subtle text-success">Ödenen: ${tl(x.totalPaid)}</span></div>
                <div class="mt-1"><span class="badge bg-danger-subtle text-danger">Kalan: ${tl(x.remaining)}</span></div>
              </div>`;
                a.onclick = () => selectCustomer(x.id, a);
                els.custList.appendChild(a);
            });
            els.listCount.textContent = (items || []).length;
            els.sumRemain.textContent = tl(totRemain);
            els.sumPaid.textContent = tl(totPaid);
            els.sumSales.textContent = tl(totSales);
        }

        let activeItem = null;
        async function selectCustomer(id, el) {
            if (activeItem) activeItem.classList.remove('active');
            activeItem = el; activeItem.classList.add('active');

            const r = await fetch(`/CreditTracking/CustomerDetails?customerId=${id}`);
            if (!r.ok) { alert('Detay alınamadı.'); return; }
            const vm = await r.json();

            els.cName.textContent = vm.header?.name || '—';
            els.cMeta.textContent = [vm.header?.phone, vm.header?.email].filter(Boolean).join(' • ');

            els.sumSalesC.textContent = tl(vm.summary?.totalSales || 0);
            els.sumPaidC.textContent = tl(vm.summary?.totalPaid || 0);
            els.sumRemainC.textContent = tl(vm.summary?.remaining || 0);

            els.tblSales.innerHTML = '';
            (vm.sales || []).forEach(s => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
              <td>${fmtDate(s.date)}</td>
              <td>${(s.productCode || '')}${s.productName ? ` — ${s.productName}` : ''}</td>
              <td class="text-end">${s.amount ?? ''}</td>
              <td class="text-end">${tl(s.netPrice)}</td>
              <td class="text-end">${tl(s.totalPrice)}</td>
              <td class="text-end">${tl(s.paid)}</td>
              <td class="text-end">${tl(s.remaining)}</td>`;
                els.tblSales.appendChild(tr);
            });

            // ✅ Ödeme geçmişi artık camelCase alanlardan okunuyor
            els.payList.innerHTML = '';
            (vm.payments || []).forEach(p => {
                const div = document.createElement('div');
                div.className = 'list-group-item d-flex align-items-center justify-content-between';
                div.innerHTML = `
              <div class="small">
                <div class="fw-semibold">${p.cashType || 'Ödeme'}</div>
                <div class="text-muted">${p.description || ''}</div>
              </div>
              <div class="text-end">
                <div class="fw-semibold text-success">+ ${tl(p.amount)}</div>
                <div class="small text-muted">${fmtDate(p.createDate)} — Satış #${p.saleId}</div>
              </div>`;
                els.payList.appendChild(div);
            });

            els.hint.style.display = (vm.sales?.length || vm.payments?.length) ? 'none' : 'block';
        }

        function debounce(fn, t = 300) { let h; return (...a) => { clearTimeout(h); h = setTimeout(() => fn(...a), t); }; }
        async function loadCustomers(q = '') {
            const r = await fetch(`/CreditTracking/Customers?q=${encodeURIComponent(q)}`);
            if (!r.ok) { alert('Liste alınamadı.'); return; }
            const data = await r.json();
            renderCustomers(data);
        }

        els.q.addEventListener('input', debounce(() => loadCustomers(els.q.value), 300));
        loadCustomers();
    </script>

    <style>
        .list-group-item.active {
            background-color: #e7f1ff !important;
            color: inherit !important;
            border-color: #cfe2ff !important;
        }

            .list-group-item.active * {
                color: inherit !important;
            }
    </style>
}
