@{
    ViewData["Title"] = "Giriş";
    Layout = null;
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <title>Giriş</title>
    <style>
        body {
            min-height: 100vh;
            background: #f6f8fb;
            display: flex;
            align-items: center
        }

        .card {
            max-width: 420px;
            margin: auto
        }
    </style>
</head>
<body>
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h4 class="mb-3">Mori • Giriş</h4>
            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <input id="u" class="form-control" autocomplete="username">
            </div>
            <div class="mb-3">
                <label class="form-label">Parola</label>
                <input id="p" type="password" class="form-control" autocomplete="current-password">
            </div>
            <button id="btn" class="btn btn-primary w-100">Giriş</button>
            <div id="msg" class="text-danger small mt-2" style="display:none;"></div>
        </div>
    </div>

    <script>
        // ----- Token helpers -----
        const getToken = () => localStorage.getItem('jwt') || '';
        const getExp = () => Number(localStorage.getItem('jwt_exp') || 0);
        const isValid = () => { const t = getToken(), e = getExp(); return !!t && e > 0 && Date.now() < e; };
        const saveToken = (token, expIso) => {
            localStorage.setItem('jwt', token);
            localStorage.setItem('jwt_exp', String(new Date(expIso).getTime()));
        };
        const clearToken = () => { localStorage.removeItem('jwt'); localStorage.removeItem('jwt_exp'); };

        // Global fetch wrapper (Authorization + 401'de Login'e dön)
        (function () {
            const base = window.fetch;
            window.fetch = function (input, init) {
                init = init || {}; init.headers = init.headers || {};
                const t = getToken();
                if (t) {
                    if (init.headers instanceof Headers) init.headers.set('Authorization', 'Bearer ' + t);
                    else init.headers['Authorization'] = 'Bearer ' + t;
                }
                return base(input, init).then(r => {
                    if (r.status === 401) {
                        clearToken();
                        if (!location.pathname.toLowerCase().startsWith('/login')) {
                            location.href = '/Login/Login';
                        }
                    }
                    return r;
                });
            };
        })();

        // Sayfa açılışında token geçerliyse Home
        (function () {
            if (isValid()) {
                // İstersen ping ile doğrula:
                // fetch('/Login/Ping').then(r=>{ if(r.ok) location.href='/Home/Index'; else clearToken(); });
                location.href = '/Home/Index';
            }
        })();

        // Login
        document.getElementById('btn')?.addEventListener('click', async () => {
            const u = document.getElementById('u').value.trim();
            const p = document.getElementById('p').value.trim();
            const msg = document.getElementById('msg'); msg.style.display = 'none';
            if (!u || !p) { msg.textContent = 'Kullanıcı adı ve parola zorunlu.'; msg.style.display = 'block'; return; }

            const r = await fetch('/Login/Login', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userName: u, password: p })
            });

            if (!r.ok) {
                msg.textContent = (await r.text().catch(() => '')) || 'Giriş başarısız.'; msg.style.display = 'block';
                return;
            }
            const d = await r.json();
            if (d?.ok && d.token && d.exp) {
                saveToken(d.token, d.exp);
                location.href = '/Home/Index';
            } else {
                msg.textContent = 'Giriş başarısız.'; msg.style.display = 'block';
            }
        });
    </script>
</body>
</html>
