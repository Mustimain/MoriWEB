@{
    ViewData["Title"] = "Giriş";
    Layout = null;
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <title>Giriş</title>
    <style>
        body {
            min-height: 100vh;
            background: #f6f8fb;
            display: flex;
            align-items: center;
        }

        .card {
            max-width: 420px;
            margin: auto;
        }
    </style>
</head>
<body>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h4 class="mb-3">Mori • Giriş</h4>

            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <input id="u" class="form-control" autocomplete="username" autofocus>
            </div>

            <div class="mb-3">
                <label class="form-label">Parola</label>
                <input id="p" type="password" class="form-control" autocomplete="current-password">
            </div>

            <button id="btn" class="btn btn-primary w-100">
                <span class="btn-text"><i class="bi bi-box-arrow-in-right me-1"></i> Giriş</span>
                <span class="btn-spin spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
            </button>
        </div>
    </div>

    <!-- Toast Container (sağ üst) -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080;"></div>

    <!-- Bootstrap Bundle (Toast/Modal için) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- (İsteğe bağlı) Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script>
        /* ================= TOKEN HELPERS ================= */
        const getToken = () => localStorage.getItem('jwt') || '';
        const getExp = () => Number(localStorage.getItem('jwt_exp') || 0);
        const isValid = () => { const t = getToken(), e = getExp(); return !!t && e > 0 && Date.now() < e; };
        const saveToken = (token, expIso) => {
            localStorage.setItem('jwt', token);
            localStorage.setItem('jwt_exp', String(new Date(expIso).getTime()));
        };
        const clearToken = () => { localStorage.removeItem('jwt'); localStorage.removeItem('jwt_exp'); };

        /* ================= GLOBAL FETCH WRAPPER =================
           (Login harici sayfalara geçtiğinizde de aynı davranışı korur) */
        (function () {
            const base = window.fetch;
            window.fetch = function (input, init) {
                init = init || {}; init.headers = init.headers || {};
                const t = getToken();
                if (t) {
                    if (init.headers instanceof Headers) init.headers.set('Authorization', 'Bearer ' + t);
                    else init.headers['Authorization'] = 'Bearer ' + t;
                }
                return base(input, init).then(r => {
                    if (r.status === 401) {
                        clearToken();
                        if (!location.pathname.toLowerCase().startsWith('/login')) {
                            location.href = '/Login/Login';
                        }
                    }
                    return r;
                });
            };
        })();

        /* ================= TOAST HELPER ================= */
        function showToast(type, message, title = "") {
            const container = document.querySelector('.toast-container');
            const el = document.createElement('div');
            const bg =
                type === 'success' ? 'text-bg-success' :
                    type === 'error' ? 'text-bg-danger' :
                        'text-bg-secondary';
            el.className = `toast align-items-center ${bg} border-0`;
            el.setAttribute('role', 'alert'); el.setAttribute('aria-live', 'assertive'); el.setAttribute('aria-atomic', 'true');
            el.innerHTML = `
                  <div class="d-flex">
                    <div class="toast-body">
                      ${title ? `<strong class="me-2">${title}</strong>` : ""}${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                  </div>`;
            container.appendChild(el);
            const toast = new bootstrap.Toast(el, { delay: (type === 'error' ? 4000 : 3000) });
            toast.show();
            el.addEventListener('hidden.bs.toast', () => el.remove());
        }

        /* ================= AUTO-REDIRECT ================= */
        (function () {
            if (isValid()) {
                // isterseniz ping atıp doğrulayın:
                // fetch('/Login/Ping').then(r=>{ if(r.ok) location.href='/Home/Index'; else clearToken(); });
                location.href = '/Home/Index';
            }
        })();

        /* ================= LOGIN ================= */
        const $btn = document.getElementById('btn');
        const $u = document.getElementById('u');
        const $p = document.getElementById('p');
        const $spin = document.querySelector('.btn-spin');
        const $btxt = document.querySelector('.btn-text');

        function setBusy(b) {
            if (b) {
                $btn.setAttribute('disabled', 'disabled');
                $spin.classList.remove('d-none');
                $btxt.classList.add('opacity-75');
            } else {
                $btn.removeAttribute('disabled');
                $spin.classList.add('d-none');
                $btxt.classList.remove('opacity-75');
            }
        }

        async function doLogin() {
            const u = $u.value.trim();
            const p = $p.value.trim();

            if (!u || !p) {
                showToast('error', 'Kullanıcı adı ve parola zorunlu.');
                return;
            }

            setBusy(true);
            try {
                const r = await fetch('/Login/Login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userName: u, password: p })
                });

                if (!r.ok) {
                    const t = await r.text().catch(() => '');
                    showToast('error', t || 'Giriş başarısız.');
                    return;
                }
                const d = await r.json().catch(() => null);
                if (d?.ok && d.token && d.exp) {
                    saveToken(d.token, d.exp);
                    showToast('success', 'Giriş başarılı, yönlendiriliyorsunuz…');
                    // küçük bir gecikme ile yönlendir
                    setTimeout(() => location.href = '/Home/Index', 400);
                } else {
                    showToast('error', 'Giriş başarısız.');
                }
            } catch (e) {
                showToast('error', 'Sunucuya ulaşılamadı.');
            } finally {
                setBusy(false);
            }
        }

        $btn?.addEventListener('click', doLogin);
        // Enter ile gönder
        [$u, $p].forEach(el => el.addEventListener('keydown', e => {
            if (e.key === 'Enter') { doLogin(); }
        }));
    </script>
</body>
</html>
