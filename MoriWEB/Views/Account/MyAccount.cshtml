@{
    ViewData["Title"] = "Kasa Hareketleri";
    Layout = "_Layout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css" rel="stylesheet" />

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div><h3 class="mb-0">Kasa Hareketleri</h3></div>
        <span class="badge rounded-pill bg-secondary-subtle text-secondary" id="listCount">0</span>
    </div>

    <div class="row g-3">
        <!-- SOL: Liste -->
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <!-- Arama -->
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="searchBox" type="text" class="form-control" placeholder="Ara: açıklama, ürün, müşteri, tür, tutar">
                    </div>

                    <!-- Filtre -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <div class="flex-grow-1">
                            <select id="FilterTypeId" class="form-select">
                                <option value="">İşlem türüne göre filtrele (Tümü)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Özetler -->
                    <div id="totalsBar" class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-danger-subtle text-danger">Alış (−): <span id="sumIn">0,00</span></span>
                        <span class="badge bg-success-subtle text-success">Satış (+): <span id="sumOut">0,00</span></span>
                        <span class="badge bg-primary-subtle text-primary">Kasa Mevcut: <span id="sumBal">0,00</span></span>
                    </div>

                    <div id="cashList" class="list-group list-group-flush border rounded" style="max-height:65vh; overflow:auto;"></div>
                </div>
            </div>
        </div>

        <!-- SAĞ: Form -->
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-warning bg-opacity-10 p-2">
                                <i class="bi bi-wallet2 fs-5 text-warning"></i>
                            </div>
                            <div>
                                <h5 class="mb-0" id="formTitle">Yeni Kasa Kaydı</h5>
                                <div id="formSub" class="text-muted small">Bilgileri doldurun ve Kaydet’e basın.</div>
                            </div>
                        </div>
                        <span class="badge text-bg-light border" id="selectedIdBadge" style="display:none;">ID:</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">İşlem türü <span class="text-danger">*</span></label>
                            <select id="CashTransactionTypeId" class="form-select" required>
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Ürün Satışı (opsiyonel)</label>
                            <select id="ProductSalesId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ürün Alışı (opsiyonel)</label>
                            <select id="ProductEntryId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Tarih</label>
                            <input id="CreateDate" type="date" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tutar <span class="text-danger">*</span></label>
                            <input id="Amount" type="number" step="0.01" min="0" class="form-control" value="0">
                            <div class="form-text">
                                <span id="balanceBadge" class="badge bg-secondary-subtle text-secondary"></span>
                            </div>
                            <div class="invalid-feedback">Tutar 0’dan büyük olmalıdır.</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Açıklama</label>
                            <input id="Description" class="form-control" placeholder="Opsiyonel">
                        </div>

                        <!-- BAKİYE DETAY PANELİ -->
                        <div class="col-12">
                            <div id="balancePanel" class="border rounded p-3 d-none">
                                <div class="d-flex flex-wrap gap-3 mb-2">
                                    <span class="badge bg-light text-dark">Toplam: <span id="balTotal">0.00</span></span>
                                    <span class="badge bg-light text-dark">Ödenen: <span id="balPaid">0.00</span></span>
                                    <span class="badge bg-primary-subtle text-primary">Kalan: <span id="balRemain">0.00</span></span>
                                </div>
                                <div class="small text-muted mb-1">Ödeme geçmişi</div>
                                <div id="balancePayments" class="list-group list-group-flush"></div>
                            </div>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end mt-2">
                            <button type="button" class="btn btn-primary" id="btnSave">
                                <i class="bi bi-save2"></i> Kaydet
                            </button>
                            <button type="button" class="btn btn-success d-none" id="btnUpdate">
                                <i class="bi bi-arrow-repeat"></i> Güncelle
                            </button>
                            <button type="button" class="btn btn-outline-danger d-none" id="btnDelete">
                                <i class="bi bi-trash"></i> Sil
                            </button>
                        </div>
                    </div> <!-- /row -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
<script>
/* ===== Helpers ===== */
function g(o, ...keys){ for(const k of keys){ if(o && o[k]!=null) return o[k]; } return ""; }
function normalizeDateForInput(v){
  if(!v) return "";
  if(typeof v==="string") return v.length>=10 ? v.substring(0,10) : v;
  const d=v instanceof Date ? v : new Date(v); if(isNaN(d)) return "";
  const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,'0'), dd=String(d.getDate()).padStart(2,'0');
  return `${y}-${m}-${dd}`;
}
function todayStr(){ const d=new Date(); const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,'0'), dd=String(d.getDate()).padStart(2,'0'); return `${y}-${m}-${dd}`; }
function tl(v){ return Number(v||0).toLocaleString('tr-TR',{minimumFractionDigits:2, maximumFractionDigits:2}); }

/* ===== Refs ===== */
const idBadge=document.getElementById('selectedIdBadge');
const formTitle=document.getElementById('formTitle');
const formSub=document.getElementById('formSub');

const btnSave=document.getElementById('btnSave');
const btnUpdate=document.getElementById('btnUpdate');
const btnDelete=document.getElementById('btnDelete');

const listHost=document.getElementById('cashList');
const listCount=document.getElementById('listCount');
const searchBox=document.getElementById('searchBox');

const balancePanel=document.getElementById('balancePanel');
const balanceBadge=document.getElementById('balanceBadge');
const balTotal=document.getElementById('balTotal');
const balPaid=document.getElementById('balPaid');
const balRemain=document.getElementById('balRemain');
const balancePayments=document.getElementById('balancePayments');

const sumInEl  = document.getElementById('sumIn');   // Alış (−)
const sumOutEl = document.getElementById('sumOut');  // Satış (+)
const sumBalEl = document.getElementById('sumBal');  // Kasa Mevcut

let currentRemain = 0;
let currentTarget = null; // {kind:'entry'|'sale', id:number}
let lastItems = [];       // Son arama sonucunun ham listesi

/* ===== Tom Select ===== */
const ts = {};
function initTom(selectId, options, cfg={}){
  const el=document.getElementById(selectId); if(!el) return;
  if(ts[selectId]){ ts[selectId].destroy(); ts[selectId]=null; }
  el.innerHTML = `<option value="">${cfg.placeholder || 'Seçiniz...'}</option>`;
  ts[selectId] = new TomSelect(el, {
    valueField: 'value',
    labelField: 'label',
    searchField: cfg.searchFields || ['label'],
    options: options || [],
    items: [],
    allowEmptyOption: true,
    create: false,
    shouldSort: false,
    placeholder: cfg.placeholder || 'Seçiniz...',
    render: {
      option:(d,esc)=>`<div>${esc(d.label)}</div>`,
      item  :(d,esc)=>`<div>${esc(d.label)}</div>`
    }
  });
}
const getSelVal = (id)=> ts[id] ? (ts[id].getValue() || "") : (document.getElementById(id)?.value || "");

/* ===== State/UI ===== */
function refreshCount(){
  const c=document.querySelectorAll('#cashList .cash-item').length;
  if(listCount) listCount.innerText=c;
}
function setSelected(id){
  const has=!!id && id>0;
  if(has){
    idBadge.style.display='inline-block';
    idBadge.textContent=`ID:${id}`;
    formTitle.textContent='Kasa Kaydı Güncelle';
    formSub.textContent='Düzenleyip Güncelle/Sil yapabilirsiniz.';
    btnSave.classList.add('d-none');
    btnUpdate.classList.remove('d-none');
    btnDelete.classList.remove('d-none');
  }else{
    idBadge.style.display='none';
    idBadge.textContent='';
    formTitle.textContent='Yeni Kasa Kaydı';
    formSub.textContent='Bilgileri doldurun ve Kaydet’e basın.';
    btnSave.classList.remove('d-none');
    btnUpdate.classList.add('d-none');
    btnDelete.classList.add('d-none');
  }
}
function getSelectedId(){
  const m=(idBadge.textContent||"").match(/ID:\s*(\d+)/i);
  return m?parseInt(m[1]):0;
}

/* ===== Form set/get ===== */
function setForm(o){
  const map={
    CashTransactionTypeId:['cashTransactionTypeId','CashTransactionTypeId'],
    ProductSalesId:['productSalesId','ProductSalesId'],
    ProductEntryId:['productEntryId','ProductEntryId'],
    CreateDate:['createDate','CreateDate'],
    Amount:['amount','Amount'],
    Description:['description','Description']
  };
  for(const [id,keys] of Object.entries(map)){
    let v=g(o,...keys);
    if(id==='CreateDate') v=normalizeDateForInput(v);
    if(ts[id]){ ts[id].setValue(v?String(v):""); ts[id].wrapper.classList.remove('is-invalid'); }
    else{ const el=document.getElementById(id); if(el){ el.value=(v??'')===null?'':v; el.classList?.remove('is-invalid'); } }
  }
  currentTarget=null;
  if(o.productEntryId){ if(ts['ProductEntryId']) ts['ProductEntryId'].setValue(String(o.productEntryId)); onTargetChange(); }
  else if(o.productSalesId){ if(ts['ProductSalesId']) ts['ProductSalesId'].setValue(String(o.productSalesId)); onTargetChange(); }
}
function getForm(){
  const toInt=v=>v===""?null:parseInt(v,10);
  const toDec=v=>v===""?null:parseFloat(v);
  return {
    CashTransactionTypeId: toInt(getSelVal('CashTransactionTypeId')),
    ProductSalesId: toInt(getSelVal('ProductSalesId')),
    ProductEntryId: toInt(getSelVal('ProductEntryId')),
    CreateDate: document.getElementById('CreateDate')?.value ?? "",
    Amount: toDec(document.getElementById('Amount')?.value ?? ""),
    Description: (document.getElementById('Description')?.value ?? "").trim()
  };
}
function clearForm(){
  setForm({});
  setSelected(0);
  document.querySelectorAll('#cashList .cash-item.active').forEach(x=>x.classList.remove('active'));
  document.getElementById('CreateDate').value=todayStr();
  document.getElementById('Amount').value=0;
  document.getElementById('Description').value="";
  currentRemain=0;
  currentTarget=null;
  renderBalance(null);
}

/* ===== Bakiye paneli ===== */
function renderBalance(data){
  if(!data){
    balancePanel.classList.add('d-none');
    balanceBadge.textContent='';
    balancePayments.innerHTML='';
    return;
  }
  balancePanel.classList.remove('d-none');
  balTotal.textContent = tl(data.total);
  balPaid.textContent  = tl(data.paid);
  balRemain.textContent= tl(data.remaining);
  balanceBadge.textContent = `Kalan: ${tl(data.remaining)}`;
  balancePayments.innerHTML = (data.payments||[]).map(p=>`
    <div class="list-group-item d-flex justify-content-between align-items-center">
      <div class="small">
        <div>${p.type ?? '-'}</div>
        <div class="text-muted">${(p.description ?? '')}</div>
      </div>
      <div class="text-end">
        <div class="fw-semibold">${tl(p.amount)}</div>
        <div class="small text-muted">${(p.createDate||'').toString().substring(0,10)}</div>
      </div>
    </div>`).join('');
}
async function onTargetChange(){
  const saleId = parseInt(getSelVal('ProductSalesId')||'0',10);
  const entryId= parseInt(getSelVal('ProductEntryId')||'0',10);

  let data=null;
  try{
    if (saleId>0){ currentTarget={kind:'sale',id:saleId}; data = await ui.apiGet(`/Account/SaleBalance?id=${saleId}`); }
    else if (entryId>0){ currentTarget={kind:'entry',id:entryId}; data = await ui.apiGet(`/Account/EntryBalance?id=${entryId}`); }
    else { currentTarget=null; }
  }catch(_){ ui.showToast('error','Bakiye bilgisi alınamadı.'); }

  currentRemain = data?.remaining ?? 0;
  renderBalance(data || null);
}

/* ===== Liste render ===== */
function renderList(items){
  listHost.innerHTML="";
  (items||[]).forEach(it=>{
    const id=g(it,'id','Id');
    const tx=g(it,'transactionType','TransactionType'); // 0=Alış(−) 1=Satış(+)
    const signChar = (Number(tx)===1) ? '+' : '−';
    const pillClass = (Number(tx)===1) ? 'pill-pos' : 'pill-neg';

    const typeName=g(it,'cashTypeName','CashTypeName')||'-';
    const pCode=g(it,'productCode','ProductCode')||'';
    const pName=g(it,'productName','ProductName')||'';
    const cust=g(it,'customerName','CustomerName')||'';
    const amt=g(it,'amount','Amount')??0;
    const desc=g(it,'description','Description')||'';
    const dt=normalizeDateForInput(g(it,'createDate','CreateDate'))||'';

    const line2=[pCode,pName].filter(Boolean).join(' — ');
    const line3=[cust?`[${cust}]`:null, desc||null].filter(Boolean).join(' • ');

    const btn=document.createElement('button');
    btn.type='button';
    btn.className='list-group-item list-group-item-action d-flex align-items-start gap-3 cash-item';
    btn.innerHTML=`
      <div class="flex-fill text-start">
        <div class="d-flex justify-content-between align-items-center">
          <div class="fw-semibold">${typeName}</div>
          <div class="small text-muted">${dt}</div>
        </div>
        ${line2?`<div class="text-body-secondary mt-1">${line2}</div>`:``}
        ${line3?`<div class="small text-muted mt-1">${line3}</div>`:``}
      </div>
      <div class="text-end">
        <div class="fw-bold amount-pill ${pillClass}">${signChar}${Number(amt).toFixed(2)}</div>
      </div>`;
    btn.addEventListener('click',()=>{
      const was=btn.classList.contains('active');
      document.querySelectorAll('#cashList .cash-item.active').forEach(x=>x.classList.remove('active'));
      if(was){ clearForm(); setSelected(0); return; }
      btn.classList.add('active');
      setForm(it);
      setSelected(id);
    });
    listHost.appendChild(btn);
  });
  refreshCount();
}

/* ===== Özet hesap ===== */
function updateTotals(items){
  let alis=0, satis=0;
  (items||[]).forEach(it=>{
    const tx = Number(g(it,'transactionType','TransactionType'));
    const amt= Number(g(it,'amount','Amount')||0);
    if(tx===1) satis += amt; else alis += amt;
  });
  const mevcut = satis - alis;
  sumInEl.textContent  = tl(alis);
  sumOutEl.textContent = tl(satis);
  sumBalEl.textContent = tl(mevcut);
}

/* ===== API (ui yardımcıları ile) ===== */
async function apiLookups(){ try{ return await ui.apiGet('/Account/Lookups'); } catch(_){ ui.showToast('error','Lookups alınamadı.'); return {}; } }
async function apiList(q=""){ try{ return await ui.apiGet(`/Account/Search?q=${encodeURIComponent(q)}`); } catch(_){ ui.showToast('error','Liste alınamadı.'); return []; } }
async function apiCreate(model){ const r = await ui.apiPostJson('/Account/Create', model); if(!r.ok) ui.showToast('error', r.message || 'Kayıt başarısız.'); return r; }
async function apiUpdate(id, model){ const r = await ui.apiPostJson('/Account/Update', {...model, Id:id}); if(!r.ok) ui.showToast('error', r.message || 'Güncelleme başarısız.'); return r; }
async function apiDelete(id){ const r = await ui.apiPostJson('/Account/Delete', {Id:id}); if(!r.ok) ui.showToast('error', r.message || 'Silme başarısız.'); return r; }

/* ===== Ham veri -> filtrele -> render ===== */
function filterItems(items){
  const raw = getSelVal('FilterTypeId');
  const typeId = parseInt(raw || '0', 10);
  if(!typeId) return items;
  return (items||[]).filter(x => Number(g(x,'cashTransactionTypeId','CashTransactionTypeId')||0) === typeId);
}
function renderFromLast(){
  const filtered = filterItems(lastItems);
  renderList(filtered);
  updateTotals(filtered);
}

/* ===== İlk yükleme ===== */
(async ()=>{
  const lk = await apiLookups();

  initTom('CashTransactionTypeId',
    (lk.cashTypes||[]).map(x=>({ value:String(x.id), label:`${Number(x.sign)===1?'+':'−'} ${x.code} - ${x.name}`, sign:x.sign })),
    { searchFields:['label'], placeholder:'Seçiniz...' });

  initTom('FilterTypeId',
    [{value:"",label:"İşlem türüne göre filtrele (Tümü)"}]
      .concat((lk.cashTypes||[]).map(x=>({ value:String(x.id), label:`${x.code} - ${x.name}` }))),
    { searchFields:['label'], placeholder:'İşlem türü (Tümü)' });

  initTom('ProductSalesId', (lk.sales||[]).map(x=>({ value:String(x.id), label:x.text })), { searchFields:['label'], placeholder:'Seçiniz...' });
  initTom('ProductEntryId', (lk.entries||[]).map(x=>({ value:String(x.id), label:x.text })), { searchFields:['label'], placeholder:'Seçiniz...' });

  ts['ProductSalesId']?.on('change', async ()=>{ ts['ProductEntryId']?.clear(true); await onTargetChange(); });
  ts['ProductEntryId']?.on('change', async ()=>{ ts['ProductSalesId']?.clear(true); await onTargetChange(); });

  ts['FilterTypeId']?.on('change', ()=>{ setSelected(0); renderFromLast(); });

  document.getElementById('CreateDate').value = todayStr();

  lastItems = await apiList("");
  renderFromLast();
  setSelected(0);
})();

/* ===== Etkileşimler ===== */
searchBox?.addEventListener('input', async function(){
  lastItems = await apiList(this.value || "");
  setSelected(0);
  renderFromLast();
});

function validateForm(){
  let ok = true;

  const typeVal = getSelVal('CashTransactionTypeId');
  const typeBad = !typeVal;
  if(ts['CashTransactionTypeId']) ts['CashTransactionTypeId'].wrapper.classList.toggle('is-invalid', typeBad);
  ok = ok && !typeBad;

  const amountEl = document.getElementById('Amount');
  const amount = parseFloat(amountEl.value || '0');
  const badAmount = !(amount > 0);
  amountEl.classList.toggle('is-invalid', badAmount);
  ok = ok && !badAmount;

  if (currentTarget && amount > currentRemain + 1e-9) {
    ui.showToast('error', `Tutar kalan bakiyeyi aşamaz. Kalan: ${tl(currentRemain)}`);
    ok = false;
  }
  return ok;
}

btnSave?.addEventListener('click', async ()=>{
  if (!validateForm()) return;
  const r = await apiCreate(getForm());
  if(!r.ok) return;
  ui.showToast('success','Kasa kaydı oluşturuldu.');
  lastItems = await apiList(searchBox?.value || "");
  clearForm(); setSelected(0);
  renderFromLast();
});

btnUpdate?.addEventListener('click', async ()=>{
  const id = getSelectedId(); if(!id){ ui.showToast('error','Seçim yok.'); return; }
  if (!validateForm()) return;

  const r = await apiUpdate(id, getForm());
  if(!r.ok) return;
  ui.showToast('success','Güncellendi.');
  lastItems = await apiList(searchBox?.value || "");
  clearForm(); setSelected(0);
  renderFromLast();
});

btnDelete?.addEventListener('click', async ()=>{
  const id = getSelectedId(); if(!id){ ui.showToast('error','Seçim yok.'); return; }
  const ok = await ui.showConfirm('Silmek istediğinize emin misiniz?', 'Silme Onayı'); if(!ok) return;
  const r = await apiDelete(id);
  if(!r.ok) return;
  ui.showToast('success','Silindi.');
  lastItems = await apiList(searchBox?.value || "");
  clearForm(); setSelected(0);
  renderFromLast();
});
</script>

<style>
  /* Kasa liste kartları */
  .cash-item{ transition: background-color .15s ease, border-color .15s ease; }
  .cash-item.active{ background-color:#f2f6ff !important; color:inherit !important; border-color:#d9e6ff !important; }

  /* Tutar pill */
  .amount-pill{ display:inline-block; padding:.25rem .6rem; border-radius:999px; min-width:105px; text-align:right; font-variant-numeric:tabular-nums; box-shadow:inset 0 0 0 1px rgba(0,0,0,.04); }
  .pill-pos{ background:#e9f7ee; color:#0a7a2e; }   /* + (Satış) */
  .pill-neg{ background:#fde8ea; color:#b4232b; }   /* − (Alış) */

  /* Bakiye paneli */
  #balancePanel .list-group-item{ padding:.5rem .75rem; }

  /* ID rozeti */
  .id-badge{ color:#000 !important; background:#f8f9fa !important; border:1px solid #dee2e6 !important; font-weight:500; }

  /* Mobil */
  @@media (max-width:991.98px){ #cashList{ max-height:40vh; overflow:auto; } }

  /* Hata kenarlığı */
  .is-invalid{ border-color:#dc3545 !important; }

  /* Tom Select – tek border ve OK ikonlarını tamamen gizle */
  .ts-wrapper{ border:0 !important; box-shadow:none !important; }
  .ts-wrapper .ts-control{
    border:1px solid var(--bs-border-color) !important;
    border-radius:.375rem !important;
    min-height:calc(2.5rem + 2px);
    padding:.375rem .75rem;
    box-shadow:none !important;
    background-color:#fff !important;
    background-image:none !important; /* bazı temalarda ok arka planla gelebilir */
  }
  .ts-wrapper.is-invalid .ts-control{ border-color:#dc3545 !important; }

  /* ▼ tüm ok varyasyonları */
  .ts-control::after,
  .ts-control:after,
  .ts-wrapper .ts-control::after,
  .ts-wrapper .ts-control:after,
  .ts-wrapper.single .ts-control::after,
  .ts-wrapper.single .ts-control:after{
    content:'' !important;
    display:none !important;
    width:0 !important;
    height:0 !important;
    background:none !important;
    border:0 !important;
  }
</style>
}
