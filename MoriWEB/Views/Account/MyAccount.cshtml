@{
    ViewData["Title"] = "Kasa Hareketleri";
    Layout = "_Layout";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="mb-0">Kasa Hareketleri</h3>
            <small class="text-muted">Soldan hareket seç → sağda güncelle/sil. Seçmeden formu doldur → yeni kayıt ekle.</small>
        </div>
        <span class="badge rounded-pill bg-secondary-subtle text-secondary" id="listCount">0</span>
    </div>

    <div class="row g-3">
        <!-- SOL: Liste -->
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="searchBox" type="text" class="form-control" placeholder="Ara: açıklama, ürün, müşteri, tür, tutar">
                    </div>

                    <div id="cashList" class="list-group list-group-flush border rounded" style="max-height: 65vh; overflow:auto;">
                        @* JS ile doldurulacak *@
                    </div>
                </div>
            </div>
        </div>

        <!-- SAĞ: Form -->
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-warning bg-opacity-10 p-2">
                                <i class="bi bi-wallet2 fs-5 text-warning"></i>
                            </div>
                            <div>
                                <h5 class="mb-0" id="formTitle">Yeni Kasa Kaydı</h5>
                                <small class="text-muted" id="formSub">Bilgileri doldurun ve Kaydet’e basın.</small>
                            </div>
                        </div>
                        <span class="badge text-bg-light border" id="selectedIdBadge" style="display:none;">ID:</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">İşlem</label>
                            <select id="TransactionType" class="form-select">
                                <option value="">Seçiniz...</option>
                                <option value="0">Giriş</option>
                                <option value="1">Çıkış</option>
                            </select>
                            <div class="form-text">Boş bırakılırsa 0/1 Cash Türü koduna göre varsayılır.</div>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Kasa Türü</label>
                            <select id="CashTransactionTypeId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Satış (opsiyonel)</label>
                            <select id="ProductSalesId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Stok Girişi (opsiyonel)</label>
                            <select id="ProductEntryId" class="form-select">
                                <option value="">Seçiniz...</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Tarih</label>
                            <input id="CreateDate" type="date" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tutar</label>
                            <input id="Amount" type="number" step="0.01" min="0" class="form-control" value="0">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Açıklama</label>
                            <input id="Description" class="form-control" placeholder="Opsiyonel">
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end mt-2">
                            <button type="button" class="btn btn-outline-secondary" id="btnClear">
                                <i class="bi bi-plus-circle"></i> Yeni Kayıt
                            </button>
                            <button type="button" class="btn btn-primary" id="btnSave">
                                <i class="bi bi-save2"></i> Kaydet
                            </button>
                            <button type="button" class="btn btn-success d-none" id="btnUpdate">
                                <i class="bi bi-arrow-repeat"></i> Güncelle
                            </button>
                            <button type="button" class="btn btn-outline-danger d-none" id="btnDelete">
                                <i class="bi bi-trash"></i> Sil
                            </button>
                        </div>
                    </div> <!-- /row -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* ===== Helpers ===== */
        function g(o, ...keys){ for(const k of keys){ if(o && o[k]!=null) return o[k]; } return ""; }
        function normalizeDateForInput(v){
            if(!v) return "";
            if(typeof v==="string") return v.length>=10 ? v.substring(0,10) : v;
            const d=v instanceof Date?v:new Date(v); if(isNaN(d)) return "";
            const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,'0'), dd=String(d.getDate()).padStart(2,'0');
            return `${y}-${m}-${dd}`;
        }
        function todayStr(){ const d=new Date(); const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,'0'), dd=String(d.getDate()).padStart(2,'0'); return `${y}-${m}-${dd}`; }

        /* ===== Refs ===== */
        const idBadge=document.getElementById('selectedIdBadge');
        const formTitle=document.getElementById('formTitle');
        const formSub=document.getElementById('formSub');

        const btnClear=document.getElementById('btnClear');
        const btnSave=document.getElementById('btnSave');
        const btnUpdate=document.getElementById('btnUpdate');
        const btnDelete=document.getElementById('btnDelete');

        const listHost=document.getElementById('cashList');
        const listCount=document.getElementById('listCount');
        const searchBox=document.getElementById('searchBox');

        /* ===== State/UI ===== */
        function refreshCount(){
            const c=document.querySelectorAll('#cashList .cash-item').length;
            if(listCount) listCount.innerText=c;
        }
        function setSelected(id){
            const has=!!id && id>0;
            if(has){
                idBadge.style.display='inline-block';
                idBadge.textContent=`ID:${id}`;
                formTitle.textContent='Kasa Kaydı Güncelle';
                formSub.textContent='Düzenleyip Güncelle/Sil yapabilirsiniz.';
                btnClear.classList.add('d-none');
                btnSave.classList.add('d-none');
                btnUpdate.classList.remove('d-none');
                btnDelete.classList.remove('d-none');
            }else{
                idBadge.style.display='none';
                idBadge.textContent='';
                formTitle.textContent='Yeni Kasa Kaydı';
                formSub.textContent='Bilgileri doldurun ve Kaydet’e basın.';
                btnClear.classList.remove('d-none');
                btnSave.classList.remove('d-none');
                btnUpdate.classList.add('d-none');
                btnDelete.classList.add('d-none');
            }
        }
        function getSelectedId(){
            const m=(idBadge.textContent||"").match(/ID:\s*(\d+)/i);
            return m?parseInt(m[1]):0;
        }

        /* ===== Form set/get ===== */
        function setForm(o){
            const map={
                TransactionType:['transactionType','TransactionType'],
                CashTransactionTypeId:['cashTransactionTypeId','CashTransactionTypeId'],
                ProductSalesId:['productSalesId','ProductSalesId'],
                ProductEntryId:['productEntryId','ProductEntryId'],
                CreateDate:['createDate','CreateDate'],
                Amount:['amount','Amount'],
                Description:['description','Description']
            };
            for(const [id,keys] of Object.entries(map)){
                const el=document.getElementById(id); if(!el) continue;
                let v=g(o,...keys);
                if(id==='CreateDate') v=normalizeDateForInput(v);
                el.value=(v??'')===null?'':v;
            }
        }
        function getForm(){
            const toInt=v=>v===""?null:parseInt(v,10);
            const toDec=v=>v===""?null:parseFloat(v);
            return {
                TransactionType: toInt(document.getElementById('TransactionType')?.value ?? ""),
                CashTransactionTypeId: toInt(document.getElementById('CashTransactionTypeId')?.value ?? ""),
                ProductSalesId: toInt(document.getElementById('ProductSalesId')?.value ?? ""),
                ProductEntryId: toInt(document.getElementById('ProductEntryId')?.value ?? ""),
                CreateDate: document.getElementById('CreateDate')?.value ?? "",
                Amount: toDec(document.getElementById('Amount')?.value ?? ""),
                Description: (document.getElementById('Description')?.value ?? "").trim()
            };
        }
        function clearForm(){
            setForm({});
            setSelected(0);
            document.querySelectorAll('.cash-item.active').forEach(x=>x.classList.remove('active'));
            document.getElementById('CreateDate').value=todayStr();
            document.getElementById('Amount').value=0;
            document.getElementById('Description').value="";
        }

        /* ===== Render list ===== */
        function renderList(items){
            listHost.innerHTML="";
            items.forEach(it=>{
                const id=g(it,'id','Id');
                const tx=g(it,'transactionType','TransactionType'); // 0=Giriş 1=Çıkış
                const typeName=g(it,'cashTypeName','CashTypeName')||'-';
                const pCode=g(it,'productCode','ProductCode')||'';
                const pName=g(it,'productName','ProductName')||'';
                const cust=g(it,'customerName','CustomerName')||'';
                const amt=g(it,'amount','Amount')??0;
                const desc=g(it,'description','Description')||'';
                const dt=normalizeDateForInput(g(it,'createDate','CreateDate'))||'';

                const sign = tx===1 ? '-' : '+'; // çıkış kırmızı / giriş yeşil
                const colorClass = tx===1 ? 'text-danger' : 'text-success';

                const btn=document.createElement('button');
                btn.type='button';
                btn.className='list-group-item list-group-item-action d-flex align-items-start gap-3 cash-item';
                btn.innerHTML=`
                    <div class="flex-fill text-start">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge ${tx===1?'text-bg-danger':'text-bg-success'}">${tx===1?'Çıkış':'Giriş'}</span>
                            <span class="small text-muted">${typeName}</span>
                            <span class="small text-muted ms-2">${dt}</span>
                        </div>
                        <div class="fw-semibold mt-1">${pCode} ${pName ? '— '+pName : ''} ${cust ? ' ['+cust+']' : ''}</div>
                        ${desc ? `<div class="small mt-1">${desc}</div>` : ``}
                    </div>
                    <div class="text-end">
                        <div class="fw-bold ${colorClass}">${sign}${Number(amt).toFixed(2)}</div>
                        <span class="badge id-badge mt-2">ID:${id}</span>
                    </div>
                `;

                btn.addEventListener('click',()=>{
                    const was=btn.classList.contains('active');
                    document.querySelectorAll('.cash-item.active').forEach(x=>x.classList.remove('active'));
                    if(was){ clearForm(); setSelected(0); return; }
                    btn.classList.add('active');
                    setForm(it);
                    setSelected(id);
                });

                listHost.appendChild(btn);
            });
            refreshCount();
        }

        /* ===== API ===== */
        async function apiLookups(){
            const r=await fetch('/Account/Lookups');
            if(!r.ok) throw new Error('Lookups alınamadı');
            return await r.json();
        }
        async function apiList(q=""){
            const r=await fetch(`/Account/Search?q=${encodeURIComponent(q)}`);
            if(!r.ok) throw new Error('Liste alınamadı');
            return await r.json();
        }
        async function apiCreate(model){
            const r=await fetch('/Account/Create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(model)});
            if(r.status===400){ alert('Zorunlu alanları kontrol edin.'); return {ok:false}; }
            if(!r.ok){ alert('Kayıt başarısız'); return {ok:false}; }
            return {ok:true, data:await r.json()};
        }
        async function apiUpdate(id, model){
            const r=await fetch('/Account/Update',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...model, Id:id})});
            if(r.status===404){ alert('Kayıt bulunamadı.'); return {ok:false}; }
            if(r.status===400){ alert('Zorunlu alanları kontrol edin.'); return {ok:false}; }
            if(!r.ok){ alert('Güncelleme başarısız'); return {ok:false}; }
            return {ok:true, data:await r.json()};
        }
        async function apiDelete(id){
            const r=await fetch('/Account/Delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({Id:id})});
            if(r.status===404){ alert('Kayıt bulunamadı.'); return {ok:false}; }
            if(r.status===400){ alert('Geçersiz istek (id).'); return {ok:false}; }
            if(!r.ok){ alert('Silme başarısız'); return {ok:false}; }
            return {ok:true};
        }

        /* ===== Select doldurma ===== */
        function fillSelect(id, items, getText){
            const sel=document.getElementById(id); if(!sel) return;
            sel.innerHTML='<option value="">Seçiniz...</option>' + (items||[]).map(x=>`<option value="${x.id}">${getText(x)}</option>`).join('');
        }

        /* ===== İlk yükleme ===== */
        (async ()=>{
            const lk = await apiLookups();
            fillSelect('CashTransactionTypeId', lk.cashTypes, x => `${x.code} - ${x.name}`);
            fillSelect('ProductSalesId', lk.sales, x => x.text);
            fillSelect('ProductEntryId', lk.entries, x => x.text);

            document.getElementById('CreateDate').value = todayStr();

            const items = await apiList("");
            renderList(items);
            setSelected(0);
        })();

        /* ===== Etkileşimler ===== */
        searchBox?.addEventListener('input', async function(){
            const items = await apiList(this.value || "");
            renderList(items);
            setSelected(0);
        });

        btnClear?.addEventListener('click', ()=>{ clearForm(); setSelected(0); });

        btnSave?.addEventListener('click', async ()=>{
            const body=getForm();
            if((body.Amount ?? 0) <= 0){ alert('Tutar > 0 olmalı.'); return; }
            const r=await apiCreate(body);
            if(!r.ok) return;
            alert('Kasa kaydı oluşturuldu.');
            const items=await apiList(searchBox?.value||"");
            renderList(items);
            clearForm(); setSelected(0);
        });

        btnUpdate?.addEventListener('click', async ()=>{
            const id=getSelectedId(); if(!id){ alert('Seçim yok'); return; }
            const body=getForm();
            if((body.Amount ?? 0) <= 0){ alert('Tutar > 0 olmalı.'); return; }
            const r=await apiUpdate(id, body);
            if(!r.ok) return;
            alert('Güncellendi.');
            const items=await apiList(searchBox?.value||"");
            renderList(items);
            clearForm(); setSelected(0);
        });

        btnDelete?.addEventListener('click', async ()=>{
            const id=getSelectedId(); if(!id){ alert('Seçim yok'); return; }
            if(!confirm('Silmek istediğinize emin misiniz?')) return;
            const r=await apiDelete(id);
            if(!r.ok) return;
            alert('Silindi.');
            const active=document.querySelector('#cashList .cash-item.active');
            if(active){ active.parentElement.removeChild(active); refreshCount(); }
            clearForm(); setSelected(0);
        });
    </script>
    <style>
        .cash-item.active{
            background-color:#e7f1ff !important;
            color:inherit !important;
            border-color:#cfe2ff !important;
        }
        .cash-item.active *{ color:inherit !important; }
        .id-badge{
            color:#000 !important;
            background-color:#f8f9fa !important;
            border:1px solid #dee2e6 !important;
            font-weight:500;
        }
        @@media (max-width: 991.98px){
            #cashList{ max-height:40vh; overflow:auto; }
        }
    </style>
}
