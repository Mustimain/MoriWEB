@{
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
    var act = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
    bool IsActive(string c, string a = "") =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(a) || string.Equals(act, a, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MoriWEB</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MoriWEB.styles.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">

    <nav class="navbar navbar-expand-lg navbar-dark topbar shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Product" asp-action="Products">
                <i class="bi bi-gem"></i> MoriWEB
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü Aç/Kapat">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-3 nav-compact">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Product" asp-action="Products">
                            <i class="bi bi-box-seam"></i> Ürün Oluştur
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="ProductEntry" asp-action="ProductEntries">
                            <i class="bi bi-arrow-down-square"></i> Ürün Stok Girişi Yap
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="ProductSale" asp-action="ProductSales">
                            <i class="bi bi-arrow-up-square"></i> Satış Yap
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Customer" asp-action="Customers">
                            <i class="bi bi-people"></i> Müşteri Ekle
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Category" asp-action="Categories">
                            <i class="bi bi-tags"></i> Kategori Ekle
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Account" asp-action="MyAccount">
                            <i class="bi bi-cash-coin"></i> Kasa
                        </a>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer fixed-bottom bg-white border-top">
        <div class="container text-muted small py-2">
            &copy; @DateTime.Now.Year - MoriWEB
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <style>
        body {
            padding-bottom: 56px;
        }

        .topbar {
            background: linear-gradient(90deg, #0b2b4a 0%, #0d6efd 55%, #0a58ca 100%);
        }

        .navbar-brand {
            letter-spacing: .3px;
        }

        .navbar .nav-link {
            color: rgba(255,255,255,.9);
            padding: .6rem .9rem;
            border-radius: .5rem;
        }

            .navbar .nav-link:hover {
                color: #fff;
                background: rgba(255,255,255,.12);
            }

            .navbar .nav-link.active {
                color: #fff;
                background: rgba(255,255,255,.2);
                box-shadow: inset 0 0 0 1px rgba(255,255,255,.15);
            }

            .navbar .nav-link i {
                width: 1.2rem;
                text-align: center;
            }

        .dropdown-menu {
            border-radius: .75rem;
        }

        .navbar .nav-compact {
            gap: .45rem; /* <li>’ler arası */
        }

            /* Linklerin iç dolgusu daha kompakt */
            .navbar .nav-compact .nav-link {
                padding: .35rem .6rem; /* sağ/sol daha dar */
                display: inline-flex;
                align-items: center;
                line-height: 1.2;
            }

                /* İkon ile başlık arasında hafif boşluk */
                .navbar .nav-compact .nav-link i {
                    margin-right: .4rem; /* ikon–metin arası boşluk */
                    line-height: 1;
                }
    </style>
</body>
</html>
