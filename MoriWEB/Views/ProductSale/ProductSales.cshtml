@{
    ViewData["Title"] = "Stok Çıkışları";
    Layout = "_Layout";
}

<!-- Sadece Tom Select CSS (_Layout Bootstrap/Icons yüklüyor) -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css" rel="stylesheet" />

<div class="container-fluid py-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div><h3 class="mb-0">Stok Çıkışları</h3></div>
    <span class="badge rounded-pill bg-secondary-subtle text-secondary" id="listCount">0</span>
  </div>

  <div class="row g-3">
    <!-- SOL: Liste -->
    <div class="col-12 col-lg-5">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="input-group mb-3">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input id="searchBox" type="text" class="form-control" placeholder="Ara: ürün adı/kodu, müşteri, ödeme">
          </div>
          <div id="salesList" class="list-group list-group-flush border rounded" style="max-height:65vh; overflow:auto;"></div>
        </div>
      </div>
    </div>

    <!-- SAĞ: Form -->
    <div class="col-12 col-lg-7">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle bg-danger bg-opacity-10 p-2">
                <i class="bi bi-arrow-up-square fs-5 text-danger"></i>
              </div>
              <div><h5 class="mb-0" id="formTitle">Yeni Stok Çıkışı</h5></div>
            </div>
            <span class="badge text-bg-light border" id="selectedIdBadge" style="display:none;">ID:</span>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Müşteri <span class="text-danger">*</span></label>
              <!-- form-select SINIFI KALDIRILDI -->
              <select id="CustomerId" required>
                <option value="">Seçiniz...</option>
              </select>
              <div class="invalid-feedback">Müşteri seçiniz.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label">Ürün (Stok) <span class="text-danger">*</span></label>
              <select id="ProductId" required>
                <option value="">Seçiniz...</option>
              </select>
              <div class="invalid-feedback">Ürün seçiniz.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Tarih</label>
              <input id="CreateDate" type="date" class="form-control">
            </div>
            <div class="col-md-6">
              <label class="form-label">Ödeme Türü <span class="text-danger">*</span></label>
              <select id="PaymentTypeId" required>
                <option value="">Seçiniz...</option>
              </select>
              <div class="invalid-feedback">Ödeme türü seçiniz.</div>
            </div>

            <div class="col-md-3">
              <label class="form-label">Miktar <span class="text-danger">*</span></label>
              <input id="Amount" type="number" min="0.01" step="0.01" class="form-control" value="1" required>
              <div class="form-text"><span id="stockInfo" class="text-muted">Stok: -</span></div>
              <div class="invalid-feedback">Miktar 0'dan büyük olmalı ve stoktan fazla olamaz.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">Satış Fiyat <span class="text-danger">*</span></label>
              <input id="SalesPrice" type="number" min="0.01" step="0.01" class="form-control" value="0" required>
              <div class="invalid-feedback">Satış fiyatı 0'dan büyük olmalı.</div>
            </div>
            <div class="col-md-3">
              <label class="form-label">İskonto (%)</label>
              <input id="SalesDiscount" type="number" min="0" max="100" step="0.01" class="form-control" value="0">
            </div>
            <div class="col-md-3">
              <label class="form-label">Net Birim</label>
              <input id="NetPrice" class="form-control" readonly>
            </div>

            <div class="col-md-6">
              <label class="form-label">Toplam Tutar</label>
              <input id="TotalPrice" class="form-control" readonly>
            </div>
            <div class="col-md-6">
              <label class="form-label">Etiket Fiyat (Son)</label>
              <input id="LabelPrice" class="form-control" readonly>
            </div>

            <div class="col-md-6">
              <label class="form-label">Ödenen Tutar</label>
              <input id="PaymentAmount" type="number" min="0" step="0.01" class="form-control" value="0">
              <div class="form-text">Peşin alınan kısım. Kasa kaydına sadece bu tutar yazılır.</div>
            </div>

            <div class="col-12 d-flex gap-2 justify-content-end mt-2">
              <button type="button" class="btn btn-primary" id="btnSave">
                <i class="bi bi-save2"></i> Kaydet
              </button>
              <button type="button" class="btn btn-success d-none" id="btnUpdate">
                <i class="bi bi-arrow-repeat"></i> Güncelle
              </button>
              <button type="button" class="btn btn-outline-danger d-none" id="btnDelete">
                <i class="bi bi-trash"></i> Sil
              </button>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
<script>
/* ==== Helpers ==== */
function g(o,...keys){ for(const k of keys){ if(o && o[k]!=null) return o[k]; } return ""; }
function normalizeDateForInput(v){ if(!v) return ""; if(typeof v==="string") return v.length>=10?v.substring(0,10):v; const d=new Date(v); if(isNaN(d)) return ""; const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,'0'), day=String(d.getDate()).padStart(2,'0'); return `${y}-${m}-${day}`; }
function todayStr(){ const d=new Date(); const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,'0'), day=String(d.getDate()).padStart(2,'0'); return `${y}-${m}-${day}`; }

/* ==== Refs ==== */
const idBadge=document.getElementById('selectedIdBadge');
const formTitle=document.getElementById('formTitle');
const listHost=document.getElementById('salesList');
const listCount=document.getElementById('listCount');
const searchBox=document.getElementById('searchBox');
const btnSave=document.getElementById('btnSave');
const btnUpdate=document.getElementById('btnUpdate');
const btnDelete=document.getElementById('btnDelete');
let currentStock=0;

/* ==== Tom Select ==== */
const ts = {}; // { CustomerId, ProductId, PaymentTypeId }
function initTom(selectId, items, cfg={}){
  const el=document.getElementById(selectId); if(!el) return;
  if(ts[selectId]){ ts[selectId].destroy(); ts[selectId]=null; }
  const opts=(items||[]).map(x=>({
    id:x.id, code:x.code, name:x.name, phone:x.phone,
    label: (cfg.template==='product')
      ? [x.code, x.name].filter(Boolean).join(' — ')
      : (cfg.template==='customer'
          ? (x.phone ? `${x.name} (${x.phone})` : x.name)
          : (x.name ?? ''))
  }));
  el.innerHTML = `<option value="">Seçiniz...</option>`;
  ts[selectId] = new TomSelect(el,{
    valueField:'id',
    labelField:'label',
    searchField: cfg.searchFields || ['name','code','phone','label'],
    options: opts,
    items: [],
    allowEmptyOption:true,
    placeholder:'Seçiniz...',
    create:false,
    shouldSort:false,
    render:{
      option:(d,esc)=>`<div>${esc(d.label)}</div>`,
      item:(d,esc)=>`<div>${esc(d.label)}</div>`
    }
  });
}

/* ==== Sayaç ==== */
function refreshCount(){ const c=document.querySelectorAll('#salesList .sale-item').length; if(listCount) listCount.textContent=c; }

/* ==== Seçim buton durumu ==== */
function setSelected(id){
  const has=!!id && id>0;
  if(has){
    idBadge.style.display='inline-block'; idBadge.textContent=`ID:${id}`;
    formTitle.textContent='Stok Çıkışı Güncelle';
    btnSave.classList.add('d-none'); btnUpdate.classList.remove('d-none'); btnDelete.classList.remove('d-none');
  }else{
    idBadge.style.display='none'; idBadge.textContent='';
    formTitle.textContent='Yeni Stok Çıkışı';
    btnSave.classList.remove('d-none'); btnUpdate.classList.add('d-none'); btnDelete.classList.add('d-none');
  }
}
function getSelectedId(){ const m=(idBadge.textContent||"").match(/ID:\s*(\d+)/i); return m?parseInt(m[1]):0; }

/* ==== Form I/O ==== */
function setForm(obj){
  const map={
    CustomerId:['customerId','CustomerId'],
    ProductId:['productId','ProductId'],
    PaymentTypeId:['paymentTypeId','PaymentTypeId'],
    Amount:['amount','Amount'],
    SalesPrice:['salesPrice','SalesPrice'],
    SalesDiscount:['salesDiscount','SalesDiscount'],
    NetPrice:['netPrice','NetPrice'],
    TotalPrice:['totalPrice','TotalPrice'],
    CreateDate:['createDate','CreateDate']
  };
  for(const [id,keys] of Object.entries(map)){
    let val=g(obj,...keys);
    if(id==='CreateDate') val=normalizeDateForInput(val);
    if(ts[id]){ ts[id].setValue(val?String(val):""); ts[id].wrapper.classList.remove('is-invalid'); }
    else { const el=document.getElementById(id); if(el){ el.value=(val??'')===null?'':val; el.classList?.remove('is-invalid'); } }
  }
}
function getForm(){
  const toInt=v=>v===""?null:parseInt(v,10);
  const toDec=v=>v===""?null:parseFloat(v);
  const getSel=id=> ts[id] ? (ts[id].getValue() || "") : (document.getElementById(id)?.value || "");
  return {
    CustomerId: toInt(getSel('CustomerId')),
    ProductId:  toInt(getSel('ProductId')),
    PaymentTypeId: toInt(getSel('PaymentTypeId')),
    Amount: toDec(document.getElementById('Amount')?.value||""),
    SalesPrice: toDec(document.getElementById('SalesPrice')?.value||""),
    SalesDiscount: toDec(document.getElementById('SalesDiscount')?.value||""),
    NetPrice: toDec(document.getElementById('NetPrice')?.value||""),
    TotalPrice: toDec(document.getElementById('TotalPrice')?.value||""),
    CreateDate: document.getElementById('CreateDate')?.value||""
  };
}
function clearForm(){
  setForm({}); setSelected(0);
  document.querySelectorAll('.sale-item.active').forEach(x=>x.classList.remove('active'));
  document.getElementById('CreateDate').value=todayStr();
  document.getElementById('NetPrice').value="";
  document.getElementById('TotalPrice').value="";
  document.getElementById('LabelPrice').value="";
  document.getElementById('PaymentAmount').value="0";
  currentStock=0; document.getElementById('stockInfo').textContent='Stok: -';
}

/* ==== Hesaplar ==== */
function calcNetAndTotal(){
  const amt=parseFloat(document.getElementById('Amount').value||"0");
  const sp=parseFloat(document.getElementById('SalesPrice').value||"0");
  const disc=parseFloat(document.getElementById('SalesDiscount').value||"0");
  const net=sp*(1-(disc/100)); const tot=amt*net;
  document.getElementById('NetPrice').value=isFinite(net)?net.toFixed(2):"0.00";
  document.getElementById('TotalPrice').value=isFinite(tot)?tot.toFixed(2):"0.00";
}
['Amount','SalesPrice','SalesDiscount'].forEach(id=>document.getElementById(id)?.addEventListener('input',calcNetAndTotal));

function validatePaidNotExceedTotal(){
  const pay = parseFloat(document.getElementById('PaymentAmount').value||'0');
  const total = parseFloat(document.getElementById('TotalPrice').value||'0');
  if (isNaN(pay) || pay < 0) { ui.showToast('error','Ödenen Tutar 0 veya daha büyük olmalı.'); return false; }
  if (pay > total) { ui.showToast('error','Ödenen Tutar toplamı geçemez.'); return false; }
  return true;
}

/* ==== Liste ==== */
function renderList(items){
  listHost.innerHTML="";
  items.forEach(s=>{
    const id=g(s,'id','Id'); const cust=g(s,'customerName','CustomerName')||'(Müşteri yok)';
    const phone=g(s,'customerPhone','CustomerPhone')||''; const pCd=g(s,'productCode','ProductCode')||'';
    const pNm=g(s,'productName','ProductName')||''; const pay=g(s,'paymentTypeName','PaymentTypeName')||'';
    const amt=g(s,'amount','Amount')??''; const net=g(s,'netPrice','NetPrice')??''; const tot=g(s,'totalPrice','TotalPrice')??'';
    const dt=normalizeDateForInput(g(s,'createDate','CreateDate'))||'';
    const btn=document.createElement('button'); btn.type='button'; btn.className='list-group-item list-group-item-action d-flex align-items-start gap-3 sale-item';
    btn.innerHTML=`<div class="flex-fill text-start">
      <div class="fw-semibold">${pCd||''} — ${pNm||''}</div>
      <div class="small text-muted"><span class="me-2">Müşteri: ${cust}${phone?` (${phone})`:''}</span> •
        <span class="ms-2">Ödeme: ${pay||'-'}</span> • <span class="ms-2">${dt}</span></div>
      <div class="small text-muted mt-1"><span class="me-3">Miktar: <strong>${amt}</strong></span>
        <span class="me-3">Net: <strong>${net}</strong></span><span class="me-3">Toplam: <strong>${tot}</strong></span></div></div>
      <div><span class="badge id-badge">ID:${id}</span></div>`;
    btn.addEventListener('click',()=>{
      const was=btn.classList.contains('active');
      document.querySelectorAll('.sale-item.active').forEach(x=>x.classList.remove('active'));
      if(was){ clearForm(); setSelected(0); return; }
      btn.classList.add('active');
      setForm(s);
      setSelected(id);

      // ürünü seçince stok ve son etiket fiyatını çek
      if (s.productId){
        if(ts['ProductId']){ ts['ProductId'].setValue(String(s.productId)); }
        document.getElementById('ProductId').dispatchEvent(new Event('change'));
      }
    });
    listHost.appendChild(btn);
  });
  refreshCount();
}

/* ==== API (ui yardımcılarıyla) ==== */
async function apiLookups(){
  return await ui.apiGet('/ProductSale/Lookups');
}
async function apiList(q=""){
  try{ return await ui.apiGet(`/ProductSale/Search?q=${encodeURIComponent(q)}`); }
  catch{ return []; }
}
async function apiCreate(model){
  const productId = ts['ProductId']?.getValue() || document.getElementById('ProductId').value || "";
  const paymentAmount = document.getElementById('PaymentAmount').value || "0";
  return await ui.apiPostJson(`/ProductSale/Create?productId=${encodeURIComponent(productId)}&paymentAmount=${encodeURIComponent(paymentAmount)}`, model);
}
async function apiUpdate(id, model){
  const productId = ts['ProductId']?.getValue() || document.getElementById('ProductId').value || "";
  const paymentAmount = document.getElementById('PaymentAmount').value || "0";
  return await ui.apiPostJson(`/ProductSale/Update?productId=${encodeURIComponent(productId)}&paymentAmount=${encodeURIComponent(paymentAmount)}`, { ...model, Id:id });
}
async function apiDelete(id){
  return await ui.apiPostJson('/ProductSale/Delete', { Id:id });
}

/* ==== Validasyon ==== */
function validateForm(){
  let ok=true;
  const custBad = !ts['CustomerId'] || !ts['CustomerId'].getValue();
  const prodBad = !ts['ProductId']  || !ts['ProductId'].getValue();
  const payBad  = !ts['PaymentTypeId'] || !ts['PaymentTypeId'].getValue();

  if(ts['CustomerId'])   ts['CustomerId'].wrapper.classList.toggle('is-invalid', custBad);
  if(ts['ProductId'])    ts['ProductId'].wrapper.classList.toggle('is-invalid',  prodBad);
  if(ts['PaymentTypeId'])ts['PaymentTypeId'].wrapper.classList.toggle('is-invalid', payBad);

  if(custBad || prodBad || payBad) ok=false;

  const amount=parseFloat(document.getElementById('Amount').value||'0');
  const price=parseFloat(document.getElementById('SalesPrice').value||'0');
  const disc =parseFloat(document.getElementById('SalesDiscount').value||'0');
  const aEl=document.getElementById('Amount'), pEl=document.getElementById('SalesPrice'), dEl=document.getElementById('SalesDiscount');
  const aBad=!(amount>0), pBad=!(price>0), dBad=!(disc>=0);
  aEl.classList.toggle('is-invalid', aBad); pEl.classList.toggle('is-invalid', pBad); dEl.classList.toggle('is-invalid', dBad);
  if(amount>currentStock){ aEl.classList.add('is-invalid'); ok=false; }
  return ok;
}

/* ==== İlk yükleme ==== */
(async ()=>{
  const lk = await apiLookups().catch(()=>null);
  if(lk){
    initTom('CustomerId', lk.customers, { template:'customer', searchFields:['name','phone','label'] });
    initTom('ProductId',  lk.products,  { template:'product',  searchFields:['code','name','label'] });
    initTom('PaymentTypeId', lk.paymentTypes, { template:'plain', searchFields:['name','label'] });
  }

  const cd=document.getElementById('CreateDate'); if(cd) cd.value=todayStr();

  // Ürün seçimi → stok & son etiket
  const handler = async ()=>{
    const val = ts['ProductId']?.getValue() || document.getElementById('ProductId').value || "";
    const pid = parseInt(val||"0",10);
    if(!pid){ currentStock=0; document.getElementById('stockInfo').textContent='Stok: -'; document.getElementById('LabelPrice').value=""; return; }
    try{
      const d = await ui.apiGet(`/ProductSale/ProductInfo?productId=${pid}`);
      currentStock=d?.totalRemaining||0;
      document.getElementById('stockInfo').textContent=`Stok: ${currentStock}`;
      document.getElementById('LabelPrice').value=Number(d?.lastLabelPrice||0).toFixed(2);
    }catch(_){}
  };
  if(ts['ProductId']) ts['ProductId'].on('change', handler);
  document.getElementById('ProductId')?.addEventListener('change', handler);

  const items = await apiList(""); renderList(items); setSelected(0);
})();

/* ==== Etkileşimler ==== */
searchBox?.addEventListener('input', async function(){
  const items=await apiList(this.value||""); renderList(items); setSelected(0);
});
btnSave?.addEventListener('click', async ()=>{
  calcNetAndTotal();
  if(!validateForm() || !validatePaidNotExceedTotal()){
    ui.showToast('error','Zorunlu alanları kontrol edin.');
    return;
  }
  const r=await apiCreate(getForm()); if(!r.ok) return;
  ui.showToast('success','Stok çıkışı oluşturuldu.');
  const items=await apiList(searchBox?.value||""); renderList(items); clearForm(); setSelected(0);
});
btnUpdate?.addEventListener('click', async ()=>{
  const id=getSelectedId(); if(!id){ ui.showToast('error','Seçim yok.'); return; }
  calcNetAndTotal();
  if(!validateForm() || !validatePaidNotExceedTotal()){
    ui.showToast('error','Zorunlu alanları kontrol edin.');
    return;
  }
  const r=await apiUpdate(id, getForm()); if(!r.ok) return;
  ui.showToast('success','Güncellendi.');
  const items=await apiList(searchBox?.value||""); renderList(items); clearForm(); setSelected(0);
});
btnDelete?.addEventListener('click', async ()=>{
  const id=getSelectedId(); if(!id){ ui.showToast('error','Seçim yok.'); return; }
  const ok = await ui.showConfirm('Silmek istediğinize emin misiniz?', 'Silme Onayı');
  if(!ok) return;
  const r=await apiDelete(id); if(!r.ok) return;
  const active=document.querySelector('#salesList .sale-item.active'); if(active){ active.remove(); refreshCount(); }
  clearForm(); setSelected(0);
  ui.showToast('success','Kayıt silindi.');
});
</script>

<style>
/* Liste seçili satır */
.sale-item.active{ background-color:#e7f1ff!important; color:inherit!important; border-color:#cfe2ff!important; }
.sale-item.active *{ color:inherit!important; }
.id-badge{ color:#000!important; background-color:#f8f9fa!important; border:1px solid #dee2e6!important; font-weight:500; }
@@media (max-width:991.98px){ #salesList{ max-height:40vh; overflow:auto; } }
.is-invalid{ border-color:#dc3545!important; }

/* ---------- Tom Select: tek sınır, gölge/ikinci sınır yok ---------- */
body .ts-wrapper{ width:100%; }
body .ts-wrapper .ts-control{
  border:1px solid var(--bs-border-color, #ced4da) !important;
  border-radius:.375rem !important;
  background:#fff !important;
  min-height:calc(2.5rem + 2px);
  padding:.375rem .75rem;
  /* ikinci çerçeve oluşturan tüm gölgeleri kapat */
  box-shadow:none !important;
}
body .ts-wrapper .ts-control *{
  box-shadow:none !important;  /* iç eleman gölgeleri de kapat */
}

/* Focus */
body .ts-wrapper.focus .ts-control,
body .ts-wrapper .ts-control:focus-within{
  border-color:#86b7fe !important;
  outline:0;
  box-shadow:0 0 0 .25rem rgba(13,110,253,.25) !important; /* sadece dış halka */
}

/* Invalid */
body .ts-wrapper.is-invalid .ts-control{
  border-color:#dc3545 !important;
  box-shadow:0 0 0 .25rem rgba(220,53,69,.25) !important;
}

/* Dropdown */
body .ts-dropdown{
  border:1px solid var(--bs-border-color, #ced4da) !important;
  border-radius:.375rem !important;
  box-shadow:0 .5rem 1rem rgba(0,0,0,.15);
  overflow:hidden;
}

/* Input/pill hizası */
body .ts-wrapper .ts-control input{ margin:0 !important; padding:0 !important; }
body .ts-wrapper .item{ line-height:1.25rem; }
</style>
}
