@using MoriWEB.Models
@{
    ViewData["Title"] = "Lookup Yönetimi";
    var types = Enum.GetValues(typeof(LookupType)).Cast<LookupType>()
        .Select(t => new { Value = (int)t, Text = t switch {
            LookupType.Brand => "Marka",
            LookupType.Category => "Kategori",
            LookupType.Color => "Renk",
            LookupType.FabricType => "Kumaş Türü",
            LookupType.Model => "Model",
            LookupType.Company => "Firma",
            LookupType.PaymentType => "Ödeme Türü",
            LookupType.CashTransactionType => "Kasa İşlem Türü",
            _ => t.ToString()
        }});
}
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="mb-0">Lookup Yönetimi</h3>
            <small class="text-muted">Sol üstten tür seç → sol listede kayıtlar. Seçmeden sağdan Kaydet; seçiliyse Güncelle/Sil.</small>
        </div>
    </div>

    <div class="row g-3">
        <!-- SOL: Tür seçimi + arama + liste -->
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-6">
                            <label class="form-label mb-1">Tür</label>
                            <select id="typePicker" class="form-select">
                                @foreach (var t in types)
                                {
                                    <option value="@t.Value">@t.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label mb-1">Ara</label>
                            <div class="input-group">
                                <input id="searchBox" type="text" class="form-control" placeholder="Kod / Ad">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body pt-0">
                    <div id="listHost" class="list-group list-group-flush border rounded" style="max-height: 65vh; overflow:auto;"></div>
                </div>

                <!-- FOOTER'DAN 'Yeni Kayıt' KALDIRILDI -->
                <div class="card-footer bg-white border-0 d-flex justify-content-between">
                    <small class="text-muted">Toplam: <span id="countBadge">0</span></small>
                </div>
            </div>
        </div>

        <!-- SAĞ: Form -->
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-2">
                                <i class="bi bi-tags fs-5 text-primary"></i>
                            </div>
                            <div>
                                <h5 class="mb-0" id="formTitle">Yeni Kayıt</h5>
                                <small class="text-muted" id="formSub">Kod ve Ad girip Kaydet’e basın.</small>
                            </div>
                        </div>
                        <span class="badge text-bg-light border" id="selectedIdBadge" style="display:none;">ID:</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Tür</label>
                            <input id="TypeRead" class="form-control" readonly>
                            <input id="TypeValue" type="hidden">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Kod</label>
                            <input id="Code" class="form-control" placeholder="Örn: MRK-001">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ad</label>
                            <input id="Name" class="form-control" placeholder="Ad">
                        </div>

                        <div class="col-12 d-flex flex-wrap gap-2 justify-content-end mt-2">
                            <button type="button" class="btn btn-primary" id="btnSave">
                                <i class="bi bi-save2"></i> Kaydet
                            </button>
                            <button type="button" class="btn btn-success d-none" id="btnUpdate">
                                <i class="bi bi-arrow-repeat"></i> Güncelle
                            </button>
                            <button type="button" class="btn btn-outline-danger d-none" id="btnDelete">
                                <i class="bi bi-trash"></i> Sil
                            </button>
                        </div>
                    </div> <!-- /row -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // --- Yardımcılar ---
    const typeMap = new Map([
        [0,'Marka'],[1,'Kategori'],[2,'Renk'],[3,'Kumaş Türü'],[4,'Model'],
        [5,'Firma'],[6,'Ödeme Türü'],[7,'Kasa İşlem Türü']
    ]);
    const $ = id => document.getElementById(id);
    const codeInput = document.getElementById('Code');

    function setSelected(id){
        const has = !!id && id > 0;

        // Güncellemede Kod alanını kilitle
        if (codeInput) {
            codeInput.readOnly = has;
            codeInput.classList.toggle('bg-light', has);
            codeInput.title = has ? 'Güncellemede Kod değiştirilemez' : '';
        }

        const b = $('selectedIdBadge');
        if(has){
            b.style.display='inline-block'; b.textContent = `ID:${id}`;
            $('formTitle').textContent = 'Kayıt Güncelle';
            $('formSub').textContent   = 'Adı düzenleyin, Güncelle veya Sil yapın.';
            $('btnSave').classList.add('d-none');
            $('btnUpdate').classList.remove('d-none');
            $('btnDelete').classList.remove('d-none');
        }else{
            b.style.display='none'; b.textContent='';
            $('formTitle').textContent = 'Yeni Kayıt';
            $('formSub').textContent   = 'Kod ve Ad girip Kaydet’e basın.';
            $('btnSave').classList.remove('d-none');
            $('btnUpdate').classList.add('d-none');
            $('btnDelete').classList.add('d-none');
        }
    }
    function getSelectedId(){
        const m = (($('selectedIdBadge').textContent)||"").match(/ID:\s*(\d+)/i);
        return m ? parseInt(m[1]) : 0;
    }
    function clearForm(){
        $('Code').value = '';
        $('Name').value = '';
        if (codeInput) {
            codeInput.readOnly = false;
            codeInput.classList.remove('bg-light');
            codeInput.title = '';
        }
        setSelected(0);
        document.querySelectorAll('.lookup-item.active').forEach(x=>x.classList.remove('active'));
    }
    function setTypeOnForm(typeVal){
        const val = parseInt(typeVal);
        $('TypeValue').value = val;
        $('TypeRead').value  = typeMap.get(val) || '';
    }

    // --- Liste render ---
    function renderList(items){
        const host = $('listHost');
        host.innerHTML = '';
        items.forEach(x=>{
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action d-flex align-items-start gap-3 lookup-item';

            const letter = (x.name||x.Name||'?').toString().charAt(0).toUpperCase();
            const code   = x.code || x.Code || '';
            const name   = x.name || x.Name || '';
            const id     = x.id   || x.Id   || 0;

            btn.innerHTML = `
                <div class="avatar rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center" style="width:38px;height:38px;">${letter}</div>
                <div class="flex-fill text-start">
                    <div class="fw-semibold">${name}</div>
                    <div class="small text-muted">Kod: ${code}</div>
                </div>
                <div><span class="badge id-badge">ID:${id}</span></div>
            `;

            btn.addEventListener('click', ()=>{
                const was = btn.classList.contains('active');
                document.querySelectorAll('.lookup-item.active').forEach(x=>x.classList.remove('active'));
                if(was){
                    // Toggle: aynı öğeye tekrar tıklayınca seçimi kaldır
                    clearForm(); return;
                }
                btn.classList.add('active');
                $('Code').value = code;
                $('Name').value = name;
                setSelected(id);
            });

            host.appendChild(btn);
        });
        $('countBadge').innerText = items.length;
    }

    // --- API ---
    async function apiList(type, q=""){
        const res = await fetch(`/Category/List?type=${type}&q=${encodeURIComponent(q)}`);
        if(!res.ok) throw new Error('Liste alınamadı');
        return await res.json();
    }
    async function apiCreate(model){
        const res = await fetch('/Category/Create', {
            method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(model)
        });
        if(res.status===409){ const d=await res.json().catch(()=>({})); alert(d?.message||'Bu kod mevcut.'); return {ok:false}; }
        if(res.status===400){ alert('Kod ve Ad zorunludur.'); return {ok:false}; }
        if(!res.ok){ alert('Kayıt başarısız'); return {ok:false}; }
        return {ok:true};
    }
    async function apiUpdate(model){
        const res = await fetch('/Category/Update', {
            method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(model)
        });
        if(res.status===404){ alert('Kayıt bulunamadı.'); return {ok:false}; }
        if(res.status===409){ const d=await res.json().catch(()=>({})); alert(d?.message||'Kod çakışması.'); return {ok:false}; }
        if(res.status===400){ const t=await res.text(); alert(t||'Geçersiz istek'); return {ok:false}; }
        if(!res.ok){ alert('Güncelleme başarısız'); return {ok:false}; }
        return {ok:true};
    }
    async function apiDelete(model){
        const res = await fetch('/Category/Delete', {
            method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(model)
        });
        if(res.status===404){ alert('Kayıt bulunamadı.'); return {ok:false}; }
        if(res.status===409){ const d=await res.json().catch(()=>({})); alert(d?.message||'İlişkili olduğu için silinemedi.'); return {ok:false}; }
        if(!res.ok){ alert('Silme başarısız'); return {ok:false}; }
        return {ok:true};
    }

    // --- Davranışlar ---
    (async ()=>{
        const picker = $('typePicker');
        picker.value = "1"; // Kategori varsayılan
        setTypeOnForm(picker.value);
        const list = await apiList(parseInt(picker.value), "");
        renderList(list);
    })();

    $('typePicker')?.addEventListener('change', async function(){
        setTypeOnForm(this.value);
        clearForm();
        const list = await apiList(parseInt(this.value), $('searchBox').value || "");
        renderList(list);
    });

    $('searchBox')?.addEventListener('input', async function(){
        const list = await apiList(parseInt($('typePicker').value), this.value || "");
        renderList(list);
    });

    $('btnSave')?.addEventListener('click', async ()=>{
        const type = parseInt($('typePicker').value);
        const code = ($('Code').value||"").trim();
        const name = ($('Name').value||"").trim();
        if(!code || !name){ alert('Kod ve Ad zorunlu'); return; }

        const r = await apiCreate({ lookupType:type, code, name });
        if(!r.ok) return;
        alert('Kayıt eklendi.');
        const list = await apiList(type, $('searchBox').value||"");
        renderList(list);
        clearForm();
    });

    $('btnUpdate')?.addEventListener('click', async ()=>{
        const id = getSelectedId(); if(!id){ alert('Seçim yok'); return; }
        const type = parseInt($('typePicker').value);
        const code = ($('Code').value||"").trim();
        const name = ($('Name').value||"").trim();
        if(!code || !name){ alert('Kod ve Ad zorunlu'); return; }

        const r = await apiUpdate({ id, lookupType:type, code, name });
        if(!r.ok) return;
        alert('Güncellendi.');
        const list = await apiList(type, $('searchBox').value||"");
        renderList(list);
        clearForm();
    });

    $('btnDelete')?.addEventListener('click', async ()=>{
        const id = getSelectedId(); if(!id){ alert('Seçim yok'); return; }
        if(!confirm('Silmek istediğinize emin misiniz?')) return;

        const type = parseInt($('typePicker').value);
        const code = ($('Code').value||"").trim();
        const name = ($('Name').value||"").trim();

        const r = await apiDelete({ id, lookupType:type, code, name });
        if(!r.ok) return;

        const active = document.querySelector('#listHost .lookup-item.active');
        if(active){ active.parentElement.removeChild(active); }
        $('countBadge').innerText = document.querySelectorAll('#listHost .lookup-item').length.toString();
        clearForm();
    });
</script>

<style>
    .lookup-item.active{
        background-color:#e7f1ff !important;
        color:inherit !important;
        border-color:#cfe2ff !important;
    }
    .lookup-item.active *{ color:inherit !important; }

    .id-badge{
        color:#000 !important;
        background-color:#f8f9fa !important;
        border:1px solid #dee2e6 !important;
        font-weight:500;
    }
    .avatar{ font-weight:600; }

    @@media (max-width: 991.98px){
        #listHost{ max-height:40vh; }
    }
</style>
}
